+"""sandbox.py — run commands in ephemeral, network-isolated, resource-capped containers."""
+
+import argparse
+import os
+import shutil
+import subprocess
+import sys
+
+
+def _find_engine() -> str:
+    for name in ("podman", "docker"):
+        if shutil.which(name):
+            return name
+    raise RuntimeError("Neither 'podman' nor 'docker' found on PATH.")
+
+
+def sandbox_run(
+    command: str,
+    workspace: str | None = None,
+    image: str = "debian:stable-slim",
+    timeout: int = 60,
+    network: str = "none",
+    memory: str = "2g",
+    pids: int = 512,
+    cpus: float = 2.0,
+) -> str:
+    engine = _find_engine()
+
+    argv = [
+        engine, "run", "--rm", "--pull=missing",
+        f"--network={network}",
+        f"--memory={memory}",
+        f"--pids-limit={pids}",
+        f"--cpus={cpus}",
+        "--cap-drop=ALL",
+        "--security-opt=no-new-privileges",
+    ]
+
+    if workspace is not None:
+        argv += ["-v", f"{os.path.abspath(workspace)}:/workspace:rw", "-w", "/workspace"]
+
+    argv += [image, "sh", "-c", command]
+
+    try:
+        result = subprocess.run(
+            argv,
+            shell=False,
+            capture_output=True,
+            timeout=timeout,
+        )
+        exit_code = result.returncode
+        stdout = result.stdout
+        stderr = result.stderr
+    except subprocess.TimeoutExpired as exc:
+        exit_code = 124
+        stdout = exc.stdout or b""
+        stderr = exc.stderr or b""
+
+    stdout_s = stdout.decode(errors="replace")
+    stderr_s = stderr.decode(errors="replace")
+
+    formatted = f"exit={exit_code}\n--- stdout ---\n{stdout_s}\n--- stderr ---\n{stderr_s}"
+
+    if len(formatted.encode()) > 50_000:
+        truncated = formatted.encode()[:50_000].decode(errors="replace")
+        formatted = truncated + "\n... [truncated]"
+
+    return formatted
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(
+        description="Run a command in an ephemeral sandbox container.",
+        add_help=True,
+    )
+    parser.add_argument("--image", default="debian:stable-slim")
+    parser.add_argument("--timeout", type=int, default=60)
+    parser.add_argument("--network", default="none", choices=["none", "bridge"])
+    parser.add_argument("--memory", default="2g")
+    parser.add_argument("--pids", type=int, default=512)
+    parser.add_argument("--cpus", type=float, default=2.0)
+    parser.add_argument("--workspace", default=os.getcwd())
+
+    args, rest = parser.parse_known_args()
+
+    if not rest or rest[0] != "--":
+        parser.error("Expected -- COMMAND [ARG ...]")
+    command_parts = rest[1:]
+    if not command_parts:
+        parser.error("No command provided after --")
+    command = " ".join(command_parts)
+
+    output = sandbox_run(
+        command=command,
+        workspace=args.workspace,
+        image=args.image,
+        timeout=args.timeout,
+        network=args.network,
+        memory=args.memory,
+        pids=args.pids,
+        cpus=args.cpus,
+    )
+
+    sys.stdout.write(output + "\n")
+
+    exit_line = output.split("\n", 1)[0]
+    code = int(exit_line.split("=", 1)[1])
+    sys.exit(code)
+
+
+if __name__ == "__main__":
+    main()
