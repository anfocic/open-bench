---
import type { CostEfficiencyEntry } from '../data/types';
import { fmtCost, fmtTok, fmtOr } from '../lib/format';
import SectionHeader from './SectionHeader.astro';
import DataTable from './DataTable.astro';

export interface Props {
  entries: CostEfficiencyEntry[];
}

const { entries } = Astro.props;

const sorted = [...entries].sort((a, b) => (a.costUsd ?? Infinity) - (b.costUsd ?? Infinity));
const cheapest = sorted[0]?.impl;
---

{entries.length > 0 && (
  <section>
    <SectionHeader id="cost" title="cost &amp; efficiency" />
    <DataTable>
      <table>
        <thead>
          <tr>
            <th>impl</th>
            <th>slug</th>
            <th>loc</th>
            <th>wall</th>
            <th>tokens</th>
            <th>cost</th>
            <th>tests</th>
            <th>$/test</th>
          </tr>
        </thead>
        <tbody>
          {sorted.map(e => {
            const isCheapest = e.impl === cheapest;
            return (
              <tr class:list={{ 'cheapest-row': isCheapest }}>
                <td class="model">{isCheapest && <span class="leader-mark" title="cheapest">$</span>}{e.impl}</td>
                <td class="num" style="font-size:var(--font-sm)">{e.modelSlug}</td>
                <td class="num">{fmtOr(e.loc, 0)}</td>
                <td class="num">{e.wallClock}</td>
                <td class="num">{fmtTok(e.tokens)}</td>
                <td class={`num ${isCheapest ? 'win' : ''}`}>{fmtCost(e.costUsd)}</td>
                <td class="num">{e.testsPassed}</td>
                <td class="num">{e.costPerTest}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </DataTable>
  </section>
)}