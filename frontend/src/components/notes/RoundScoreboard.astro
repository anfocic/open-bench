---
import { getEntry } from 'astro:content';
import Scoreboard from '../Scoreboard.astro';
import AttackScoreboard from '../AttackScoreboard.astro';
import { findChampion, findAttackChampion } from '../../lib/scoreboard';

export interface Props {
  date: string;
}

const { date } = Astro.props;
const entry = await getEntry('rounds', date);
const isObjective = entry?.data.scoringMode === 'objective';
const champ = entry
  ? (isObjective
    ? findAttackChampion(entry.data.scoreboard)
    : findChampion(entry.data.scoreboard))
  : null;
---

{entry ? (
  isObjective
    ? <AttackScoreboard entries={entry.data.scoreboard} champion={champ?.impl} />
    : <Scoreboard entries={entry.data.scoreboard} champion={champ?.impl} />
) : (
  <p class="muted"><em>(no round found for {date})</em></p>
)}
