---
import { getEntry } from 'astro:content';
import Scoreboard from '../Scoreboard.astro';
import { findChampion } from '../../lib/scoreboard';

export interface Props {
  date: string;
}

const { date } = Astro.props;
const entry = await getEntry('rounds', date);
const champ = entry ? findChampion(entry.data.scoreboard) : null;
---

{entry ? (
  <Scoreboard entries={entry.data.scoreboard} champion={champ?.impl} />
) : (
  <p class="muted"><em>(no round found for {date})</em></p>
)}
