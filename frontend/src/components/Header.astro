---
import { navLinks } from '../data/nav';

export interface Props {
  subtitle?: string;
}

const { subtitle } = Astro.props;
const path = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return path === '/' || path === '/index.html';
  return path === href || path === href + '/' || path.startsWith(href + '/');
}
---

<header id="top" class="site-header" transition:persist>
  <a href="/" class="brand" aria-label="open-bench home">
    <span class="brand-text">open-bench</span>
    {subtitle && <span class="brand-sub">/ {subtitle}</span>}
  </a>
  <nav class="site-nav" aria-label="Primary">
    {navLinks.map(link => (
      <a href={link.href} class:list={{ active: isActive(link.href) }} data-nav={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>
    ))}
  </nav>
  <script>
    function updateActiveNav() {
      const path = location.pathname;
      document.querySelectorAll<HTMLAnchorElement>('[data-nav]').forEach(a => {
        const prefix = a.dataset.nav!;
        const active = prefix === '/' ? (path === '/' || path === '/index.html') : path.startsWith(prefix);
        a.classList.toggle('active', active);
        if (active) a.setAttribute('aria-current', 'page'); else a.removeAttribute('aria-current');
      });
    }
    updateActiveNav();
    document.addEventListener('astro:after-swap', updateActiveNav);
  </script>
</header>
