---
import type { ScoreboardEntry } from '../data/types';
import SectionHeader from './SectionHeader.astro';
import DataTable from './DataTable.astro';
import ModelLabel from './ModelLabel.astro';

export interface Props {
  entries: ScoreboardEntry[];
  champion?: string;
  slugs?: Record<string, string>;
}

const { entries, champion, slugs = {} } = Astro.props;

const sorted = [...entries].sort(
  (a, b) => (a.rank ?? Infinity) - (b.rank ?? Infinity),
);
---

{entries.length > 0 && (
  <section>
    <SectionHeader
      id="scoreboard"
      title="scoreboard"
      subtitle="round 2 (Break) — objective. defense-weighted: ranked by breaches taken (lower better), then breaches landed. lowest-ranked is eliminated."
    />
    <DataTable>
      <table class="scoreboard-table">
        <thead>
          <tr>
            <th>impl</th>
            <th>defender score</th>
            <th>attacker score</th>
            <th>status</th>
          </tr>
        </thead>
        <tbody>
          {sorted.map((e) => {
            const isChamp = e.impl === champion;
            return (
              <tr class:list={{ champion: isChamp, dnf: e.eliminated }}>
                <td class="model">
                  <ModelLabel impl={e.impl} slug={slugs[e.impl]} rank={e.rank ?? null} />
                </td>
                <td class="num"><strong>{e.defenderScore ?? '—'}</strong></td>
                <td class="num">{e.attackerScore ?? '—'}</td>
                <td class="num">
                  <span class:list={['pill', e.eliminated ? 'pill-red' : 'pill-green']}>
                    {e.verdict || (e.eliminated ? 'ELIMINATED' : 'advances')}
                  </span>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </DataTable>
  </section>
)}
