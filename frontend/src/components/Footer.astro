---
import { navLinks } from '../data/nav';
---
<footer class="site-footer">
  <div class="footer-grid">
    <div class="footer-col">
      <div class="footer-heading">open-bench</div>
      <p class="footer-tag">A weekly LLM coding battle royale. Open source, open data, open methods.</p>
    </div>
    <div class="footer-col">
      <div class="footer-heading">project</div>
      {navLinks.map(link => (
        <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener' : undefined}>{link.label === 'task' ? 'task spec' : link.label}</a>
      ))}
    </div>
    <div class="footer-col">
      <div class="footer-heading">data</div>
      <a href="/#archive">all rounds</a>
      <a href="/task/sandbox">spec &amp; rubric</a>
      <a href="https://github.com/anfocic/open-bench/tree/main/builds" target="_blank" rel="noopener">raw artifacts</a>
    </div>
    <div class="footer-col">
      <div class="footer-heading">stack</div>
      <div class="footer-meta">harness <code>opencode</code></div>
      <div class="footer-meta">site <code>astro</code></div>
      <div class="footer-meta">host <code>cloudflare</code></div>
    </div>
  </div>
  <div class="footer-base">
    <span>2026</span>
    <span>·</span>
    <span>MIT</span>
    <span>·</span>
    <span>made by <a href="https://fole.dev" target="_blank" rel="noopener">fole.dev</a></span>
  </div>
</footer>
