---
import type { ReferenceOracleRow } from '../data/types';
import SectionHeader from './SectionHeader.astro';
import DataTable from './DataTable.astro';
import ModelLabel from './ModelLabel.astro';

export interface Props {
  entries: ReferenceOracleRow[];
  notes?: string | null;
  slugs?: Record<string, string>;
}

const { entries, notes, slugs = {} } = Astro.props;

const sorted = [...entries].sort((a, b) => a.attacker.localeCompare(b.attacker));
const noteLines = (notes ?? '')
  .split('\n')
  .map(l => l.trim().replace(/^[-*]\s+/, ''))
  .filter(Boolean);
---

{entries.length > 0 && (
  <section>
    <SectionHeader
      id="oracle"
      title="reference oracle"
      subtitle="every exploit suite is also run against a known-correct reference sandbox. an exploit that &ldquo;escapes&rdquo; the reference can&rsquo;t be a real escape &mdash; it&rsquo;s cheese or mis-asserted, and is excluded from the scoring above."
    />
    <DataTable>
      <table class="scoreboard-table">
        <thead>
          <tr>
            <th>attacker</th>
            <th>exploits run vs reference</th>
            <th>excluded as bogus</th>
          </tr>
        </thead>
        <tbody>
          {sorted.map((e) => (
            <tr class:list={{ dnf: e.excluded.length > 0 }}>
              <td class="model">
                <ModelLabel impl={e.attacker} slug={slugs[e.attacker]} />
              </td>
              <td class="num">{e.exploitsRun ?? '—'}</td>
              <td class="excluded">
                {e.excluded.length === 0
                  ? <span class="pill pill-green">clean</span>
                  : e.excluded.map((name) => <code>{name}</code>)}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </DataTable>

    {noteLines.length > 0 && (
      <div class="oracle-notes">
        <h3>data-quality notes</h3>
        <ul>
          {noteLines.map((line) => <li>{line}</li>)}
        </ul>
      </div>
    )}
  </section>
)}

<style>
  .excluded { display: flex; flex-wrap: wrap; gap: 6px; }
  .excluded code {
    font-family: var(--mono);
    font-size: var(--font-xs);
    background: var(--code-bg);
    padding: 2px 6px;
    border-radius: 3px;
    color: var(--fg);
  }
  .oracle-notes { margin-top: 20px; }
  .oracle-notes h3 {
    font-family: var(--mono);
    font-size: var(--font-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin: 0 0 8px;
  }
  .oracle-notes ul { margin: 0; padding-left: 18px; }
  .oracle-notes li { color: var(--muted); font-size: var(--font-sm); margin: 4px 0; }
  .oracle-notes code {
    font-family: var(--mono);
    font-size: 0.92em;
    color: var(--fg);
  }
</style>
