---
import { seoSite } from '../config/seo';
import type { SeoProps } from '../lib/seo';
import { buildJsonLd } from '../lib/jsonld';

export interface Props extends Omit<SeoProps, 'canonicalPath' | 'ogImageAlt'> {
  canonicalPath?: string;
  ogImageAlt?: string;
}

const {
  title,
  description,
  ogImage,
  ogImageAlt = seoSite.defaultOgImageAlt,
  ogType = 'website',
  canonicalPath = Astro.url.pathname,
  jsonLd = [],
  jsonLdData = {},
  publishedTime,
  prevPath,
  nextPath,
  noindex = false,
} = Astro.props;

const canonical = seoSite.url + canonicalPath;
const ogImageAbs = ogImage.startsWith('http') ? ogImage : seoSite.url + ogImage;
const robots = noindex ? 'noindex, nofollow' : 'index, follow';
const ld = buildJsonLd(jsonLd, { ...jsonLdData, canonicalPath, ogImage });
const prevAbs = prevPath ? seoSite.url + prevPath : undefined;
const nextAbs = nextPath ? seoSite.url + nextPath : undefined;
---
<title>{title}</title>
<meta name="description" content={description}>
<meta name="robots" content={robots}>
<meta name="keywords" content={seoSite.keywords.join(', ')}>
<link rel="canonical" href={canonical}>
<link rel="alternate" hreflang={seoSite.locale} href={canonical}>
<link rel="alternate" type="application/rss+xml" title="open-bench rounds" href="/feed.xml">
{prevAbs && <link rel="prev" href={prevAbs}>}
{nextAbs && <link rel="next" href={nextAbs}>}

<meta property="og:site_name" content={seoSite.name}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content={ogType}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImageAbs}>
<meta property="og:image:width" content={String(seoSite.ogImageWidth)}>
<meta property="og:image:height" content={String(seoSite.ogImageHeight)}>
<meta property="og:image:alt" content={ogImageAlt}>
<meta property="og:locale" content={seoSite.locale}>
{publishedTime && <meta property="article:published_time" content={publishedTime}>}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content={seoSite.twitterHandle}>
<meta name="twitter:creator" content={seoSite.twitterHandle}>
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImageAbs}>
<meta name="twitter:image:alt" content={ogImageAlt}>

{ld.map((obj) => (
  <script type="application/ld+json" set:html={JSON.stringify(obj)} />
))}
