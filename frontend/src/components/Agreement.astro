---
import type { AgreementEntry } from '../data/types';
import { fmtOr } from '../lib/format';
import DataTable from './DataTable.astro';

export interface Props {
  entries: AgreementEntry[];
}

const { entries } = Astro.props;
---

{entries.length > 0 && (
  <section>
    <h2 id="agreement">inter-judge agreement</h2>
    <DataTable>
      <table>
        <thead>
          <tr>
            <th>impl</th>
            <th>min</th>
            <th>max</th>
            <th>range</th>
            <th>stdev</th>
            <th>judges</th>
          </tr>
        </thead>
        <tbody>
          {entries.map(e => (
            <tr>
              <td class="model">{e.impl}</td>
              <td class="num">{fmtOr(e.minSpec, 1)}</td>
              <td class="num">{fmtOr(e.maxSpec, 1)}</td>
              <td class="num">{fmtOr(e.range, 1)}</td>
              <td class="num">{fmtOr(e.stdev, 2)}</td>
              <td class="num" style="font-size:var(--font-sm)">{e.judges}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </DataTable>
  </section>
)}