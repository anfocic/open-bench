---
const path = Astro.url.pathname;

const tabs = [
  { href: '/model-royale', label: 'overview', match: (p: string) => p === '/model-royale' || p === '/model-royale/' },
  { href: '/model-royale/rules', label: 'rules', match: (p: string) => p.startsWith('/model-royale/rules') },
  { href: '/model-royale/round', label: 'rounds', match: (p: string) => p.startsWith('/model-royale/round') },
  { href: '/model-royale/leaderboard', label: 'leaderboard', match: (p: string) => p.startsWith('/model-royale/leaderboard') },
  { href: '/model-royale/compare', label: 'compare', match: (p: string) => p.startsWith('/model-royale/compare') || p.startsWith('/model-royale/model') },
  { href: '/model-royale/writeups', label: 'writeups', match: (p: string) => p.startsWith('/model-royale/writeups') },
  { href: '/model-royale/changelog', label: 'changelog', match: (p: string) => p.startsWith('/model-royale/changelog') },
];
---

<nav class="royale-nav" aria-label="Model Royale sections">
  {tabs.map(t => (
    <a
      href={t.href}
      data-royale-tab={t.href}
      class:list={{ active: t.match(path) }}
      aria-current={t.match(path) ? 'page' : undefined}
    >{t.label}</a>
  ))}
</nav>

<style>
  .royale-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    border-bottom: 1px solid var(--rule);
    margin: 4px 0 16px;
    font-size: 14.4px;
  }
  .royale-nav a {
    color: var(--muted);
    text-decoration: none;
    padding: 8px 14px;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: color 100ms, border-color 100ms;
  }
  .royale-nav a:hover { color: var(--fg-bright); }
  .royale-nav a.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
    font-weight: 700;
  }
</style>

<script>
  function updateRoyaleTabs() {
    const path = location.pathname;
    document.querySelectorAll<HTMLAnchorElement>('[data-royale-tab]').forEach(a => {
      const href = a.dataset.royaleTab!;
      let active = false;
      if (href === '/model-royale') active = path === '/model-royale' || path === '/model-royale/';
      else if (href === '/model-royale/compare') active = path.startsWith('/model-royale/compare') || path.startsWith('/model-royale/model');
      else if (href === '/model-royale/rules') active = path === '/model-royale/rules' || path === '/model-royale/rules/';
      else active = path.startsWith(href);
      a.classList.toggle('active', active);
      if (active) a.setAttribute('aria-current', 'page'); else a.removeAttribute('aria-current');
    });
  }
  updateRoyaleTabs();
  document.addEventListener('astro:after-swap', updateRoyaleTabs);
</script>
