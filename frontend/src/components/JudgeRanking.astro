---
import type { JudgeRankingEntry } from '../data/types';
import DataTable from './DataTable.astro';
import ModelLabel from './ModelLabel.astro';

export interface Props {
  entries: JudgeRankingEntry[];
  slugs?: Record<string, string>;
}

const { entries, slugs = {} } = Astro.props;
---

{entries.length > 0 && (
  <section>
    <h2 id="judge-ranking">per-judge ranking</h2>
    <DataTable>
      <table>
        <thead>
          <tr>
            <th>judge</th>
            <th>1st</th>
            <th>2nd</th>
            <th>3rd</th>
          </tr>
        </thead>
        <tbody>
          {entries.map(e => (
            <tr>
              <td class="model"><ModelLabel impl={e.judge} slug={slugs[e.judge]} /></td>
              <td><ModelLabel impl={e.first} slug={slugs[e.first]} /></td>
              <td><ModelLabel impl={e.second} slug={slugs[e.second]} /></td>
              <td><ModelLabel impl={e.third} slug={slugs[e.third]} /></td>
            </tr>
          ))}
        </tbody>
      </table>
    </DataTable>
  </section>
)}