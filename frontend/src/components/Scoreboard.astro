---
import type { ScoreboardEntry } from '../data/types';
import { fmtNum, fmtOr, passFailClass } from '../lib/format';
import SectionHeader from './SectionHeader.astro';
import DataTable from './DataTable.astro';

export interface Props {
  entries: ScoreboardEntry[];
  champion?: string;
}

const { entries, champion } = Astro.props;

function verdictClass(v: string): string {
  const s = v.toLowerCase();
  if (s.includes('ship')) return 'pill pill-green';
  if (s.includes('fix') || s.includes('cleanup')) return 'pill pill-blue';
  if (s.includes('skip') || s.includes('reject')) return 'pill pill-red';
  return 'pill';
}

const sorted = [...entries].sort((a, b) => {
  const ta = (a.specPeer ?? 0) + (a.qualityPeer ?? 0);
  const tb = (b.specPeer ?? 0) + (b.qualityPeer ?? 0);
  return tb - ta;
});
---

{entries.length > 0 && (
  <section>
    <SectionHeader id="scoreboard" title="scoreboard" subtitle="total = peer-judged spec /15 + quality /15. hidden-tests gate the verdict." />
    <DataTable>
      <table class="scoreboard-table">
        <thead>
          <tr>
            <th>impl</th>
            <th>total</th>
            <th>spec</th>
            <th>qual</th>
            <th>build</th>
            <th>tests</th>
            <th>verdict</th>
          </tr>
        </thead>
        <tbody>
          {sorted.map((e, idx) => {
            const isChamp = e.impl === champion;
            const total = (e.specPeer ?? 0) + (e.qualityPeer ?? 0);
            return (
              <tr class:list={{ champion: isChamp }}>
                <td class="model">
                  <span class="rank">{String(idx + 1).padStart(2, '0')}</span>
                  {e.impl}
                </td>
                <td class="num"><strong>{fmtNum(total, 1)}</strong></td>
                <td class="num">{fmtOr(e.specPeer, 1)}</td>
                <td class="num">{fmtOr(e.qualityPeer, 1)}</td>
                <td class="num"><span class={passFailClass(e.hardFail ? 0 : 1, 'pill')}>{e.hardFail ? 'pass' : 'fail'}</span></td>
                <td class="num">{e.tests}</td>
                <td class="num"><span class={verdictClass(e.verdict)}>{e.verdict}</span></td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </DataTable>
  </section>
)}