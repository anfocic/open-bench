---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { repoRoot } from '../lib/paths';
import { readOptional } from '../lib/io';
import { renderMarkdown } from '../lib/markdown';

const aboutPath = repoRoot + '/ABOUT.md';
const content = readOptional(aboutPath) ?? '# About\n\nPage not found.';
const html = renderMarkdown(content);
---

<BaseLayout title="open-bench — About" description="How the open-bench harness works.">
  <Header subtitle="about" />
  <article class="prose" set:html={html} />
  <Footer />
</BaseLayout>