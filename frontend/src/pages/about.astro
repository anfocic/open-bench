---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Masthead from '../components/Masthead.astro';
import { pageSeo } from '../lib/seo';

const sections = [
  {
    id: 'what',
    title: 'what',
    body: `<p><strong>open-bench</strong> is a benchmark harness for coding LLMs. It drops a task spec into a fresh repo, drives every model through a real agent loop, runs a hidden test suite as the objective gate, and commits the full artifact set — transcripts, diffs, scores, costs — to the repository. One run, one reviewable record, everything auditable.</p><p>The engine is provider-agnostic: tasks, runs, scoring, and aggregation work without any specific agent harness. The bundled <code>--auto</code> driver shells out to <a href="https://opencode.ai">opencode</a> today; replacing it with Claude Code, Aider, or anything that can take a prompt and write to a worktree is a single-module swap. Manual flow needs no driver at all.</p><p>What it produces is a set of <a href="/benchmarks">standalone benchmarks</a> — each task run across a model lineup, with the full receipts committed. It is not a leaderboard service and not a tournament: <a href="/model-royale">Model Royale</a>, the first format that ran on it, has been retired. The artifacts are the product; the reader is the judge.</p>`,
  },
  {
    id: 'why',
    title: 'why',
    body: `<p>Vendor leaderboards give you one number, against synthetic problems, on the vendor's release schedule. open-bench gives you the receipts: the actual code each model wrote, the actual transcript, the actual cost — against tasks you author.</p><p>The objective signal is the hidden-test result, the dollar cost, and the wall-clock. Peer review — models scoring each other — is kept as a softer second read, not a verdict. You don't take a ranking on faith; you open the diff and judge for yourself.</p>`,
  },
  {
    id: 'how',
    title: 'how',
    steps: [
      'Every model in the lineup gets the same task and an isolated git worktree.',
      'Each writes its implementation through an agent harness (opencode by default, swappable) under a fixed wall-clock budget.',
      'A hidden pytest battery runs against each output — the objective gate.',
      'The models also review each other blinded, as a secondary read; cost and tokens are captured.',
      'Everything — diffs, transcripts, scores, costs — is committed as one reviewable record per run.',
    ],
  },
  {
    id: 'principles',
    title: 'principles',
    defs: [
      ['objective gate', 'Hidden tests run before any review. They decide pass/fail; no opinion inflates a non-functional output.'],
      ['transparency over ranking', 'Every diff, transcript, score and cost is committed. The artifacts are the point — you read them and judge, not a number taken on faith.'],
      ['peer review is a second read', 'Models do score each other, blinded, with self-bias measured. It is a soft signal, not a verdict — useful colour, not the headline.'],
      ['cost & wall-clock', 'Tracked as first-class columns. What a result cost is part of the result.'],
      ['reproducible', 'Re-run a benchmark, audit a score, fork the lineup. Nothing is hidden behind a service.'],
    ],
  },
  {
    id: 'more',
    title: 'more',
    links: [
      { href: 'https://github.com/anfocic/open-bench/blob/main/ABOUT.md', label: 'ABOUT.md', note: 'full methodology, scoring math, task config' },
      { href: 'https://github.com/anfocic/open-bench/tree/main/bench/scripts', label: 'bench/scripts', note: 'harness internals' },
      { href: 'https://github.com/anfocic/open-bench/tree/main/builds', label: 'builds/', note: 'per-model artifacts' },
      { href: 'https://github.com/anfocic/open-bench/tree/main/results', label: 'results/', note: 'aggregated reviews' },
      { href: '/dataset', label: 'dataset', note: 'JSON + CSV exports, schema, citation' },
      { href: '/', label: 'open-bench home →', note: '' },
    ],
  },
];

const seo = pageSeo('about', '/about');
---

<BaseLayout seo={seo}>
  <Header subtitle="about" />

  <Masthead title="about" subtitle="What open-bench is, why it exists, and how a round actually runs." />

  <nav class="toc" aria-label="Sections">
    {sections.map(s => (
      <a href={`#${s.id}`}># {s.title}</a>
    ))}
  </nav>

  <main>
    {sections.map((s, i) => (
      <section id={s.id} class="page-section">
        <h2><span class="num">[{String(i + 1).padStart(2, '0')}]</span> {s.title}</h2>

        {s.body && <div class="body" set:html={s.body} />}

        {s.steps && (
          <ol class="steps">
            {s.steps.map((step, j) => (
              <li>
                <span class="step-num">{j + 1}</span>
                <span>{step}</span>
              </li>
            ))}
          </ol>
        )}

        {s.defs && (
          <dl class="defs">
            {s.defs.map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))}
          </dl>
        )}

        {s.links && (
          <ul class="links">
            {s.links.map(l => (
              <li>
                <a href={l.href}>{l.label}</a>
                {l.note && <span class="muted"> &mdash; {l.note}</span>}
              </li>
            ))}
          </ul>
        )}
      </section>
    ))}
  </main>

  <Footer />
</BaseLayout>

<style>
  html { scroll-behavior: smooth; }
  .toc {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    align-items: baseline;
    padding: 10px 0;
    margin: 4px 0 8px;
    border-bottom: 1px dashed var(--rule);
    font-size: 14.4px;
  }
  .toc a { color: var(--muted); text-decoration: none; padding: 2px 4px; }
  .toc a:hover { color: var(--fg-bright); }

  .page-section { padding: 24px 0; border-bottom: 1px dashed var(--rule); scroll-margin-top: 16px; }
  .page-section:last-of-type { border-bottom: none; }
  .page-section h2 {
    font-size: 26px;
    margin: 0 0 14px;
    color: var(--fg-bright);
    text-transform: lowercase;
    letter-spacing: -0.01em;
  }
  .num { color: var(--accent); font-weight: 700; font-size: 15px; margin-right: 8px; }

  .body p { margin: 10px 0; line-height: 1.6; font-size: 16.2px; max-width: 70ch; }
  .body strong { color: var(--fg-bright); }
  .body a { color: var(--accent); }

  .pull {
    margin: 14px 0 0;
    padding: 12px 16px;
    border-left: 3px solid var(--accent);
    color: var(--fg-bright);
    font-size: 16.5px;
    line-height: 1.5;
    max-width: 70ch;
  }

  .steps { list-style: none; margin: 0; padding: 0; max-width: 70ch; }
  .steps li {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 12px;
    padding: 8px 0;
    border-bottom: 1px dashed var(--rule);
    font-size: 16.2px;
    line-height: 1.5;
  }
  .steps li:last-child { border-bottom: none; }
  .step-num { color: var(--accent); font-weight: 700; }
  .step-num::before { content: '['; color: var(--dim); font-weight: 400; }
  .step-num::after { content: ']'; color: var(--dim); font-weight: 400; }

  .defs { display: grid; gap: 0; max-width: 70ch; margin: 0; }
  .defs > div {
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 16px;
    padding: 8px 0;
    border-bottom: 1px dashed var(--rule);
  }
  .defs > div:last-child { border-bottom: none; }
  .defs dt { color: var(--fg-bright); font-weight: 700; text-transform: lowercase; }
  .defs dd { margin: 0; color: var(--muted); font-size: 15.6px; line-height: 1.55; }

  .links { list-style: none; margin: 0; padding: 0; max-width: 70ch; }
  .links li { padding: 6px 0; border-bottom: 1px dashed var(--rule); font-size: 16.2px; }
  .links li:last-child { border-bottom: none; }
  .links li::before { content: '> '; color: var(--dim); }
  .links a { color: var(--accent); }

  @media (max-width: 600px) {
    .defs > div { grid-template-columns: 1fr; gap: 4px; }
    .page-section h2 { font-size: 22px; }
  }
</style>

<script>
  (() => {
    const links = document.querySelectorAll<HTMLAnchorElement>('.toc a');
    const setActive = () => {
      const ids = Array.from(links).map(a => a.getAttribute('href')!.slice(1));
      let active = ids[0];
      for (const id of ids) {
        const el = document.getElementById(id);
        if (!el) continue;
        const r = el.getBoundingClientRect();
        if (r.top - 80 <= 0) active = id;
      }
      links.forEach(a => {
        const on = a.getAttribute('href') === '#' + active;
        a.style.color = on ? 'var(--accent)' : '';
        a.style.fontWeight = on ? '700' : '';
      });
    };
    setActive();
    window.addEventListener('scroll', setActive, { passive: true });
  })();
</script>
