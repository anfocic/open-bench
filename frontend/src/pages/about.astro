---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';

const sections = [
  {
    id: 'what',
    title: 'what',
    body: `<p><strong>open-bench</strong> is a benchmark harness for coding LLMs. It drops a task spec into a fresh repo, drives every model in the lineup through a real agent loop, runs a hidden test suite as the objective gate, has the models score each other, and commits the full artifact set — transcripts, diffs, judge rubrics, scores — to the repository. One round, one ranked review.</p><p>The flagship format on top of it is <a href="/model-royale">Model Royale</a>: a weekly elimination tournament between every major LLM I can get a key for. The harness is general; the tournament is one thing you can run on it.</p>`,
  },
  {
    id: 'why',
    title: 'why',
    body: `<p>Picking a coding model from leaderboards is a bad time. They benchmark one-shot prompts, report pass@1 on synthetic problems, and update on a vendor's calendar. None of that survives contact with a real agent loop where wall-clock, cost, and code quality matter as much as whether it solves the problem at all.</p><blockquote class="about-pull">Vendor leaderboards measure the model in a vacuum. open-bench measures it in the shape you'd actually deploy it.</blockquote>`,
  },
  {
    id: 'how',
    title: 'how',
    steps: [
      'Every model in the lineup gets the same task and an isolated git worktree.',
      'Each writes its implementation through opencode under a fixed wall-clock budget.',
      'A hidden pytest battery runs against each output — the objective gate.',
      'Every model judges every implementation, blinded. Cost and tokens are captured.',
      'Scores are aggregated into one ranked review per round, plus a self-bias delta.',
    ],
  },
  {
    id: 'principles',
    title: 'principles',
    principles: [
      ['objective gate', 'Hidden tests run before any judge sees the code. No vibe-check inflating a non-functional output.'],
      ['peer scoring', 'Models judge each other under blinded labels. Self-bias is measured, then excluded from the headline median.'],
      ['cost & wall-clock', 'Tracked through the harness. Cheapest-and-correct wins ties; slow-and-correct loses them.'],
      ['reproducible', 'Every transcript, diff, rubric and score is committed. Re-run a round, audit a judgment, fork the lineup.'],
    ],
  },
  {
    id: 'more',
    title: 'more',
    links: [
      { href: 'https://github.com/anfocic/open-bench/blob/main/ABOUT.md', label: 'ABOUT.md', note: 'full methodology, scoring math, task config' },
      { href: 'https://github.com/anfocic/open-bench/tree/main/bench/scripts', label: 'bench/scripts', note: 'harness internals' },
      { href: 'https://github.com/anfocic/open-bench/tree/main/builds', label: 'builds/', note: 'per-model artifacts' },
      { href: 'https://github.com/anfocic/open-bench/tree/main/results', label: 'results/', note: 'aggregated reviews' },
      { href: '/', label: 'latest round →', note: '' },
    ],
  },
];
---

<BaseLayout
  title="open-bench — about"
  description="Why open-bench exists: a coding-LLM benchmark harness built around real agent loops, hidden tests, peer review, and committed artifacts."
>
  <Header subtitle="about" />

  <nav class="about-toc" aria-label="Sections">
    {sections.map(s => (
      <a href={`#${s.id}`} data-toc={s.id}>{s.title}</a>
    ))}
    <span class="about-progress" aria-hidden="true">
      <span class="about-progress-num" data-progress-num>1</span>
      <span class="muted"> / {sections.length}</span>
    </span>
  </nav>

  <main class="about-deck" data-deck>
    {sections.map((s, i) => (
      <section
        id={s.id}
        class="about-section"
        data-section={s.id}
        data-index={i}
        data-active={i === 0 ? 'true' : undefined}
        aria-hidden={i === 0 ? 'false' : 'true'}
      >
        <div class="about-inner">
          <h2><span class="about-h-num">[{String(i + 1).padStart(2, '0')}]</span> {s.title}</h2>

          {s.body && <div class="about-body" set:html={s.body} />}

          {s.steps && (
            <ol class="about-steps">
              {s.steps.map((step, j) => (
                <li>
                  <span class="step-num">{j + 1}</span>
                  <span class="step-body">{step}</span>
                </li>
              ))}
            </ol>
          )}

          {s.principles && (
            <dl class="about-principles">
              {s.principles.map(([k, v]) => (
                <div>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))}
            </dl>
          )}

          {s.links && (
            <ul class="about-links">
              {s.links.map(l => (
                <li>
                  <a href={l.href}>{l.label}</a>
                  {l.note && <span class="muted"> &mdash; {l.note}</span>}
                </li>
              ))}
            </ul>
          )}
        </div>
      </section>
    ))}
  </main>

  <div class="about-hint muted" aria-hidden="true">
    <span>scroll · arrows · swipe</span>
  </div>
</BaseLayout>

<style is:global>
  html.about-deck-on, html.about-deck-on body {
    overflow: hidden;
    overscroll-behavior: none;
    height: 100%;
  }
  html.about-deck-on body { touch-action: none; }
</style>

<style>
  .about-toc {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    align-items: baseline;
    padding: 10px 0;
    margin-top: 4px;
    border-bottom: 1px dashed var(--rule);
    font-size: 14.4px;
  }
  .about-toc a {
    color: var(--muted);
    text-decoration: none;
    padding: 2px 4px;
  }
  .about-toc a::before { content: '# '; color: var(--dim); }
  .about-toc a:hover { color: var(--fg-bright); }
  .about-toc a.active {
    color: var(--accent);
    font-weight: 700;
  }
  .about-toc a.active::before { color: var(--accent); }
  .about-progress {
    margin-left: auto;
    font-size: 14.4px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .about-progress-num { color: var(--accent); font-weight: 700; }

  .about-deck {
    position: relative;
    height: calc(100vh - 130px);
    overflow: hidden;
  }
  .about-section {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    padding: 24px 0;
    opacity: 0;
    pointer-events: none;
  }
  .about-section[data-active] {
    opacity: 1;
    pointer-events: auto;
    view-transition-name: deck;
  }

  .about-inner {
    width: 100%;
    max-width: 70ch;
    max-height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-right: 4px;
  }
  .about-section h2 {
    font-size: 28px;
    margin: 0 0 18px;
    color: var(--fg-bright);
    text-transform: lowercase;
    letter-spacing: -0.01em;
  }
  .about-h-num { color: var(--accent); font-weight: 700; font-size: 16px; margin-right: 8px; }
  .about-body p { margin: 12px 0; line-height: 1.6; font-size: 16.2px; }
  .about-body strong { color: var(--fg-bright); }
  .about-body a { color: var(--accent); }

  .about-pull {
    margin: 18px 0 0;
    padding: 14px 18px;
    border-left: 3px solid var(--accent);
    color: var(--fg-bright);
    font-size: 17px;
    line-height: 1.5;
    font-style: normal;
  }

  .about-steps { list-style: none; margin: 0; padding: 0; }
  .about-steps li {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px dashed var(--rule);
    font-size: 16.2px;
    line-height: 1.5;
  }
  .about-steps li:last-child { border-bottom: none; }
  .step-num { color: var(--accent); font-weight: 700; }
  .step-num::before { content: '['; color: var(--dim); font-weight: 400; }
  .step-num::after { content: ']'; color: var(--dim); font-weight: 400; }

  .about-principles { margin: 0; display: grid; gap: 0; }
  .about-principles > div {
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 16px;
    padding: 10px 0;
    border-bottom: 1px dashed var(--rule);
  }
  .about-principles > div:last-child { border-bottom: none; }
  .about-principles dt {
    color: var(--fg-bright);
    font-weight: 700;
    text-transform: lowercase;
  }
  .about-principles dd {
    margin: 0;
    color: var(--muted);
    font-size: 15.6px;
    line-height: 1.55;
  }

  .about-links { margin: 0; padding-left: 0; list-style: none; }
  .about-links li {
    padding: 8px 0;
    border-bottom: 1px dashed var(--rule);
    font-size: 16.2px;
  }
  .about-links li:last-child { border-bottom: none; }
  .about-links li::before { content: '> '; color: var(--dim); }
  .about-links a { color: var(--accent); }

  .about-hint {
    position: fixed;
    bottom: 14px;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 13.2px;
    pointer-events: none;
    letter-spacing: 0.06em;
  }

  @media (max-width: 600px) {
    .about-principles > div { grid-template-columns: 1fr; gap: 4px; }
    .about-section h2 { font-size: 22px; }
    .about-deck { height: calc(100vh - 110px); }
  }

  /* View transitions: slide horizontally between sections.
     Direction is controlled by the .deck-back class on <html>. */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
  }

  /* Push: outgoing and incoming move together at full width, no fade.
     Forward = both slide left; back = both slide right. */
  @keyframes deck-push-out-left {
    from { transform: translateX(0); }
    to { transform: translateX(-100%); }
  }
  @keyframes deck-push-in-right {
    from { transform: translateX(100%); }
    to { transform: translateX(0); }
  }
  @keyframes deck-push-out-right {
    from { transform: translateX(0); }
    to { transform: translateX(100%); }
  }
  @keyframes deck-push-in-left {
    from { transform: translateX(-100%); }
    to { transform: translateX(0); }
  }

  html:not(.deck-back) ::view-transition-old(deck) {
    animation: deck-push-out-left 380ms cubic-bezier(0.32, 0.72, 0, 1) both;
  }
  html:not(.deck-back) ::view-transition-new(deck) {
    animation: deck-push-in-right 380ms cubic-bezier(0.32, 0.72, 0, 1) both;
  }
  html.deck-back ::view-transition-old(deck) {
    animation: deck-push-out-right 380ms cubic-bezier(0.32, 0.72, 0, 1) both;
  }
  html.deck-back ::view-transition-new(deck) {
    animation: deck-push-in-left 380ms cubic-bezier(0.32, 0.72, 0, 1) both;
  }
</style>

<script>
  function withViewTransition(fn: () => void) {
    const doc = document as any;
    if (doc.startViewTransition) doc.startViewTransition(fn);
    else fn();
  }

  type Cleanup = () => void;
  let cleanup: Cleanup | null = null;

  function setupAboutDeck() {
    cleanup?.();
    cleanup = null;

    const onAbout = location.pathname.startsWith('/about');
    document.documentElement.classList.toggle('about-deck-on', onAbout);
    if (!onAbout) return;

    const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('.about-toc a[data-toc]')];
    const sections = [...document.querySelectorAll<HTMLElement>('.about-section[data-section]')];
    const progress = document.querySelector<HTMLElement>('[data-progress-num]');
    if (!tocLinks.length || !sections.length) return;

    let currentIdx = 0;
    const initialHash = location.hash.slice(1);
    const initialIdx = sections.findIndex(s => s.dataset.section === initialHash);
    if (initialIdx > 0) {
      sections[0].removeAttribute('data-active');
      sections[0].setAttribute('aria-hidden', 'true');
      sections[initialIdx].setAttribute('data-active', 'true');
      sections[initialIdx].setAttribute('aria-hidden', 'false');
      currentIdx = initialIdx;
    }

    function setActive(idx: number) {
      const id = sections[idx].dataset.section!;
      tocLinks.forEach(l => {
        const on = l.dataset.toc === id;
        l.classList.toggle('active', on);
        if (on) l.setAttribute('aria-current', 'true');
        else l.removeAttribute('aria-current');
      });
      if (progress) progress.textContent = String(idx + 1);
      if (location.hash.slice(1) !== id) {
        history.replaceState(null, '', '#' + id);
      }
    }

    setActive(currentIdx);

    let busy = false;

    function goTo(nextIdx: number) {
      if (busy) return;
      if (nextIdx < 0 || nextIdx >= sections.length || nextIdx === currentIdx) return;
      const back = nextIdx < currentIdx;
      busy = true;
      document.documentElement.classList.toggle('deck-back', back);

      const apply = () => {
        sections[currentIdx].removeAttribute('data-active');
        sections[currentIdx].setAttribute('aria-hidden', 'true');
        sections[nextIdx].setAttribute('data-active', 'true');
        sections[nextIdx].setAttribute('aria-hidden', 'false');
        const inner = sections[nextIdx].querySelector<HTMLElement>('.about-inner');
        if (inner) inner.scrollTop = 0;
        currentIdx = nextIdx;
        setActive(nextIdx);
      };

      const doc = document as any;
      if (doc.startViewTransition) {
        const t = doc.startViewTransition(apply);
        t.finished.finally(() => { busy = false; });
      } else {
        apply();
        setTimeout(() => { busy = false; }, 50);
      }
    }

    // Wheel: route to next/prev. preventDefault since body overflow hidden
    // already blocks page scroll, but trackpads still send wheel events.
    let wheelLock = 0;
    function onWheel(e: WheelEvent) {
      // ignore scroll inside the inner content if it has overflow
      const inner = sections[currentIdx].querySelector<HTMLElement>('.about-inner');
      if (inner && inner.scrollHeight > inner.clientHeight) {
        const atTop = inner.scrollTop <= 0;
        const atBottom = inner.scrollTop + inner.clientHeight >= inner.scrollHeight - 1;
        if (e.deltaY > 0 && !atBottom) return;
        if (e.deltaY < 0 && !atTop) return;
      }
      e.preventDefault();
      const now = Date.now();
      if (now - wheelLock < 700) return;
      if (Math.abs(e.deltaY) < 8) return;
      wheelLock = now;
      goTo(currentIdx + (e.deltaY > 0 ? 1 : -1));
    }
    window.addEventListener('wheel', onWheel, { passive: false });

    function onKey(e: KeyboardEvent) {
      if (e.target && (e.target as HTMLElement).matches('input, textarea, [contenteditable]')) return;
      if (e.key === 'ArrowDown' || e.key === 'ArrowRight' || e.key === 'PageDown' || e.key === ' ') {
        e.preventDefault();
        goTo(currentIdx + 1);
      } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft' || e.key === 'PageUp') {
        e.preventDefault();
        goTo(currentIdx - 1);
      } else if (e.key === 'Home') {
        e.preventDefault();
        goTo(0);
      } else if (e.key === 'End') {
        e.preventDefault();
        goTo(sections.length - 1);
      }
    }
    window.addEventListener('keydown', onKey);

    let touchY: number | null = null;
    let touchX: number | null = null;
    function onTouchStart(e: TouchEvent) {
      const t = e.touches[0];
      touchY = t.clientY;
      touchX = t.clientX;
    }
    function onTouchEnd(e: TouchEvent) {
      if (touchY === null || touchX === null) return;
      const t = e.changedTouches[0];
      const dy = t.clientY - touchY;
      const dx = t.clientX - touchX;
      touchY = touchX = null;
      const adx = Math.abs(dx);
      const ady = Math.abs(dy);
      if (Math.max(adx, ady) < 40) return;
      if (ady > adx) {
        // vertical swipe — up = forward, down = back
        goTo(currentIdx + (dy < 0 ? 1 : -1));
      } else {
        // horizontal swipe — left = forward, right = back
        goTo(currentIdx + (dx < 0 ? 1 : -1));
      }
    }
    window.addEventListener('touchstart', onTouchStart, { passive: true });
    window.addEventListener('touchend', onTouchEnd, { passive: true });

    function onTocClick(this: HTMLAnchorElement, e: Event) {
      e.preventDefault();
      const id = this.dataset.toc!;
      const idx = sections.findIndex(s => s.dataset.section === id);
      if (idx >= 0) goTo(idx);
    }
    tocLinks.forEach(a => a.addEventListener('click', onTocClick));

    function onHash() {
      const id = location.hash.slice(1);
      const idx = sections.findIndex(s => s.dataset.section === id);
      if (idx >= 0 && idx !== currentIdx) goTo(idx);
    }
    window.addEventListener('hashchange', onHash);

    cleanup = () => {
      window.removeEventListener('wheel', onWheel);
      window.removeEventListener('keydown', onKey);
      window.removeEventListener('touchstart', onTouchStart);
      window.removeEventListener('touchend', onTouchEnd);
      window.removeEventListener('hashchange', onHash);
      tocLinks.forEach(a => a.removeEventListener('click', onTocClick));
      document.documentElement.classList.remove('about-deck-on', 'deck-back');
    };
  }

  setupAboutDeck();
  document.addEventListener('astro:after-swap', setupAboutDeck);
  document.addEventListener('astro:before-preparation', () => { cleanup?.(); cleanup = null; });
</script>
