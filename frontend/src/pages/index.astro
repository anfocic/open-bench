---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { loadRounds } from '../data/rounds';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import { fmtCost, fmtNum, fmtDate } from '../lib/format';

const rounds = loadRounds();
const latestRound = rounds[0];
const __dirname = fileURLToPath(new URL('.', import.meta.url));
const configPath = resolve(__dirname, '../../../bench/config.json');
let config: { implementers: string[]; slugs: Record<string, string> };
try {
  config = JSON.parse(readFileSync(configPath, 'utf-8'));
} catch { config = { implementers: [], slugs: {} }; }

const champ = latestRound?.scoreboard.reduce((best, e) => {
  const score = (e.specPeer ?? 0) + (e.qualityPeer ?? 0);
  return score > (best.score ?? 0) ? { impl: e.impl, score } : best;
}, { impl: '—', score: 0 });
const champEntry = latestRound?.scoreboard.find(e => e.impl === champ?.impl);
const modelCount = latestRound ? new Set(latestRound.samples.map(s => s.model)).size : 0;
const totalCost = latestRound ? latestRound.samples.reduce((sum, s) => sum + (s.costUsd ?? 0), 0) : 0;
const totalSamples = rounds.reduce((sum, r) => sum + r.samples.length, 0);
const totalSpend = rounds.reduce((sum, r) => sum + r.samples.reduce((s, x) => s + (x.costUsd ?? 0), 0), 0);
---

<BaseLayout title="open-bench — weekly LLM coding battle royale" description="Every week, every major coding LLM builds the same app from the same spec, alone. Hidden tests + peer review decide the winner.">
  <Header />

  <section class="masthead">
    <h1 class="masthead-title">open-bench</h1>
    <p class="masthead-lede">
      Every week, every major coding LLM gets the same blank repo and the same SPEC.md.
      Hidden tests run first &mdash; the gate. Then the models judge each other.
      Cost and wall-clock are tracked. Loser is eliminated.
    </p>
    <div class="masthead-meta">
      <span>{rounds.length} round{rounds.length === 1 ? '' : 's'}</span>
      <span>{config.implementers.length} models</span>
      <span>{totalSamples} samples</span>
      <span>{fmtCost(totalSpend)} spend</span>
      <span>last: {latestRound ? fmtDate(latestRound.date) : '&mdash;'}</span>
    </div>
  </section>

  {latestRound && champ && champ.score > 0 && (
    <section>
      <h2>latest round</h2>
      <div class="summary-line">
        Round <strong>{fmtDate(latestRound.date)}</strong>
        <span class="sep">|</span>
        winner <strong>{champ.impl}</strong> at <strong>{fmtNum(champ.score, 1)}/30</strong>
        <span class="sep">|</span>
        spec {fmtNum(champEntry?.specPeer ?? 0, 1)}, quality {fmtNum(champEntry?.qualityPeer ?? 0, 1)}
        <span class="sep">|</span>
        {modelCount} models, {fmtCost(totalCost)} total &rarr;
        <a href={`/round/${latestRound.date}`}>view round</a>
      </div>
    </section>
  )}

  <section>
    <h2>method</h2>
    <p>
      One task per round (currently <a href="/task/sandbox">sandbox</a>: a Python sandbox
      executor). Every model in the lineup gets identical SPEC.md, identical empty
      sandbox, identical wall-clock budget. No mid-run prompts, no cross-talk.
    </p>
    <p>
      Hidden pytest battery runs against each output &mdash; objective gate. Then
      every model judges every other model on spec coverage and code quality
      (peer + expert tier). Self-bias is measured and reported. Cheapest run
      wins ties. <a href="/about">Full methodology &rarr;</a>
    </p>
  </section>

  <section>
    <h2>lineup</h2>
    <div class="lineup-list">
      {config.implementers.map(impl => (
        <div class="row">
          <span class="name">{impl}</span>
          <span class="slug">{config.slugs[impl] ?? '—'}</span>
        </div>
      ))}
    </div>
  </section>

  <section id="archive">
    <h2>archive</h2>
    {rounds.length === 0 && <p class="muted">No rounds yet.</p>}
    <div class="archive-list">
      {rounds.map(r => {
        const c = r.scoreboard.reduce((best, e) => {
          const s = (e.specPeer ?? 0) + (e.qualityPeer ?? 0);
          return s > (best.score ?? 0) ? { impl: e.impl, score: s } : best;
        }, { impl: '—', score: 0 });
        const mc = new Set(r.samples.map(s => s.model)).size;
        const tc = r.samples.reduce((sum, s) => sum + (s.costUsd ?? 0), 0);
        return (
          <a href={`/round/${r.date}`}>
            <div class="row">
              <span class="date">{fmtDate(r.date)}</span>
              <span class="winner">{c.impl} <span class="muted">{fmtNum(c.score, 1)}/30</span></span>
              <span class="meta">{mc} models · {fmtCost(tc)}</span>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <Footer />
</BaseLayout>
