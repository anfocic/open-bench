---
import EmbedLayout from '../../../layouts/EmbedLayout.astro';
import EmbedScoreboard from '../../../components/embed/EmbedScoreboard.astro';
import { getCollection } from 'astro:content';
import { fmtDate } from '../../../lib/format';

export const prerender = true;

const entries = await getCollection('rounds');
const rounds = entries.map(e => e.data).sort((a, b) => b.date.localeCompare(a.date));
const round = rounds[0];
---

<EmbedLayout
  title="open-bench latest round (embed)"
  description="Scoreboard for the most recent open-bench round."
  canonicalPath={round ? `/round/${round.date}` : '/'}
>
  <h1>open-bench <span class="muted">/ {round ? `round ${fmtDate(round.date)}` : 'latest round'}</span></h1>
  {round
    ? <EmbedScoreboard entries={round.scoreboard} />
    : <p class="muted">No rounds yet.</p>}
</EmbedLayout>
