---
import EmbedLayout from '../../../layouts/EmbedLayout.astro';
import EmbedScoreboard from '../../../components/embed/EmbedScoreboard.astro';
import { getCollection } from 'astro:content';
import { fmtDate } from '../../../lib/format';

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getCollection('rounds');
  return entries.map(e => ({ params: { date: e.data.date }, props: { round: e.data } }));
}

const { round } = Astro.props;
---

<EmbedLayout
  title={`open-bench round ${round.date} (embed)`}
  description={`Scoreboard for open-bench round ${round.date}.`}
  canonicalPath={`/round/${round.date}`}
>
  <h1>open-bench <span class="muted">/ round {fmtDate(round.date)}</span></h1>
  <EmbedScoreboard entries={round.scoreboard} />
</EmbedLayout>
