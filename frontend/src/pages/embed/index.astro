---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Masthead from '../../components/Masthead.astro';
import { getCollection } from 'astro:content';
import { pageSeo } from '../../lib/seo';
import { fmtDate } from '../../lib/format';

export const prerender = true;

const entries = await getCollection('rounds');
const rounds = entries.map(e => e.data).sort((a, b) => b.date.localeCompare(a.date));
const latestRound = rounds[0];

const seo = pageSeo('embedIndex', '/embed');

const SITE = 'https://openbenchmark.dev';
const leaderboardSnippet = `<iframe
  src="${SITE}/embed/leaderboard"
  width="100%" height="320"
  loading="lazy"
  style="border:1px solid #2a2a2a;border-radius:4px"
  title="open-bench leaderboard"
></iframe>`;

const latestSnippet = `<iframe
  src="${SITE}/embed/round/latest"
  width="100%" height="320"
  loading="lazy"
  style="border:1px solid #2a2a2a;border-radius:4px"
  title="open-bench latest round"
></iframe>`;
---

<BaseLayout seo={seo}>
  <Header subtitle="embed" />
  <Masthead title="embed widgets" subtitle="Drop-in iframes for blog posts and dashboards. Static, dependency-free, follow host color scheme by default. Append <code>?theme=light</code> or <code>?theme=dark</code> to lock." />

  <section>
    <h2>leaderboard (cumulative)</h2>
    <p class="muted">Cumulative ELO standings across every round. Updates whenever a new round ships.</p>
    <iframe
      src="/embed/leaderboard"
      width="100%" height="320"
      loading="lazy"
      style="border:1px solid var(--rule);border-radius:4px"
      title="open-bench leaderboard preview"
    ></iframe>
    <details class="snippet">
      <summary>copy snippet</summary>
      <pre><code>{leaderboardSnippet}</code></pre>
    </details>
  </section>

  <section>
    <h2>latest round scoreboard</h2>
    <p class="muted">Always shows the most recent round (currently {latestRound ? fmtDate(latestRound.date) : '—'}). For a fixed round, use <code>/embed/round/&lt;YYYY-MM-DD&gt;</code>.</p>
    <iframe
      src="/embed/round/latest"
      width="100%" height="320"
      loading="lazy"
      style="border:1px solid var(--rule);border-radius:4px"
      title="open-bench latest round preview"
    ></iframe>
    <details class="snippet">
      <summary>copy snippet</summary>
      <pre><code>{latestSnippet}</code></pre>
    </details>
  </section>

  <section>
    <h2>fixed round embeds</h2>
    {rounds.length === 0 ? (
      <p class="muted">No rounds yet.</p>
    ) : (
      <ul>
        {rounds.map(r => (
          <li>
            <code>{SITE}/embed/round/{r.date}</code> &middot; <a href={`/embed/round/${r.date}`} target="_blank" rel="noopener">preview</a>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section>
    <h2>license</h2>
    <p>MIT, same as the dataset. Attribution appreciated, not required — the footer of every embed already links back.</p>
  </section>

  <Footer />
</BaseLayout>

<style>
  .snippet { margin-top: 8px; }
  .snippet summary { cursor: pointer; color: var(--accent); }
  .snippet pre { background: var(--bg-alt); padding: 10px; border-radius: 4px; overflow-x: auto; font-size: var(--font-sm); }
  ul code { font-size: var(--font-sm); }
</style>
