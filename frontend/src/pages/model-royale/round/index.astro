---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import RoyaleNav from "../../../components/RoyaleNav.astro";
import Footer from '../../../components/Footer.astro';
import Masthead from '../../../components/Masthead.astro';
import { getCollection } from 'astro:content';
import { fmtCost, fmtNum, fmtDate } from '../../../lib/format';
import { findChampion, uniqueModelCount, totalCost } from '../../../lib/scoreboard';
import { pageSeo } from '../../../lib/seo';

const entries = await getCollection('rounds');
const rounds = entries.sort((a, b) => b.id.localeCompare(a.id)).map(e => e.data);
const totalSamples = rounds.reduce((sum, r) => sum + r.samples.length, 0);
const totalSpend = rounds.reduce((sum, r) => sum + totalCost(r.samples), 0);

const seo = pageSeo('roundIndex', '/model-royale/round', {
  rounds: rounds.map(r => ({ date: r.date, winner: findChampion(r.scoreboard).impl })),
});
---

<BaseLayout seo={seo}>
  <Header subtitle="rounds" />
  <RoyaleNav />
  <Masthead title="rounds" subtitle={`Every round of open-bench, newest first. ${rounds.length} round${rounds.length === 1 ? '' : 's'}, ${totalSamples} samples, ${fmtCost(totalSpend)} total spend.`} />

  <section>
    {rounds.length === 0 && <p class="muted">No rounds yet.</p>}
    <div class="archive-list">
      {rounds.map(r => {
        const c = findChampion(r.scoreboard);
        const mc = uniqueModelCount(r.samples);
        const tc = totalCost(r.samples);
        return (
          <a href={`/model-royale/round/${r.date}`}>
            <div class="row">
              <span class="date">{fmtDate(r.date)}</span>
              <span class="winner">{c.impl} <span class="muted">{fmtNum(c.score, 1)}/30</span></span>
              <span class="meta">{mc} models · {fmtCost(tc)}</span>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <Footer />
</BaseLayout>
