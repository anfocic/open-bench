---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Header.astro';
import RoyaleNav from "../../../../components/RoyaleNav.astro";
import Footer from '../../../../components/Footer.astro';
import Masthead from '../../../../components/Masthead.astro';
import Scoreboard from '../../../../components/Scoreboard.astro';
import RoundBars from '../../../../components/charts/RoundBars.astro';
import RoundScatter from '../../../../components/charts/RoundScatter.astro';
import RunsTable from '../../../../components/RunsTable.astro';
import SelfBias from '../../../../components/SelfBias.astro';
import JudgeRanking from '../../../../components/JudgeRanking.astro';
import Agreement from '../../../../components/Agreement.astro';
import PerImplDetail from '../../../../components/PerImplDetail.astro';
import CostEfficiency from '../../../../components/CostEfficiency.astro';
import { getCollection, getEntry } from 'astro:content';
import { getRoyaleRounds } from '../../../../lib/royale';
import { fmtNum, fmtCost, fmtDate } from '../../../../lib/format';
import { findChampion, uniqueModelCount, totalCost } from '../../../../lib/scoreboard';
import { templateSeo } from '../../../../lib/seo';
import { loadSlugs } from '../../../../lib/slugs';

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getRoyaleRounds();
  const sorted = [...entries].sort((a, b) => a.id.localeCompare(b.id));
  return sorted.map((e, i) => ({
    params: { date: e.id },
    props: {
      roundId: e.id,
      prevDate: i > 0 ? sorted[i - 1].id : null,
      nextDate: i < sorted.length - 1 ? sorted[i + 1].id : null,
    },
  }));
}

const { roundId, prevDate, nextDate } = Astro.props;
const entry = await getEntry('rounds', roundId);
if (!entry) return Astro.redirect('/404');

const noteEntries = await getCollection('notes', n =>
  n.data.round === roundId && !(import.meta.env.PROD && n.data.draft)
);
const notesForRound = [...noteEntries].sort((a, b) => b.data.publishedAt.localeCompare(a.data.publishedAt));
const round = entry.data;
const champ = findChampion(round.scoreboard);
const champEntry = round.scoreboard.find(e => e.impl === champ.impl);
const modelCount = uniqueModelCount(round.samples);
const roundCost = totalCost(round.samples);
const allPassed = round.samples.length > 0 && round.samples.every(s => s.testExitCode === 0);

const taskName = 'sandbox';
const slugs = loadSlugs();

const roundLite = {
  date: round.date,
  modelCount,
  cost: roundCost,
  winner: champ.impl,
  winnerScore: Number(fmtNum(champ.score, 1)),
  task: taskName,
  scoreboard: round.scoreboard.map(e => ({ impl: e.impl, score: (e.specPeer ?? 0) + (e.qualityPeer ?? 0) })),
};
const canonicalPath = `/model-royale/round/${round.date}`;
const seo = templateSeo(
  'round',
  canonicalPath,
  {
    date: round.date,
    winnerSuffix: champ.score > 0 ? ` — ${champ.impl} wins` : '',
    winner: champ.impl,
    score: fmtNum(champ.score, 1),
    modelCount,
    cost: fmtNum(roundCost, 2),
    task: taskName,
  },
  { round: roundLite, trail: [
    { name: 'open-bench', path: '/' },
    { name: 'rounds', path: '/model-royale/round' },
    { name: `round ${round.date}`, path: canonicalPath },
  ] },
  round.date,
  {
    prevPath: prevDate ? `/model-royale/round/${prevDate}` : undefined,
    nextPath: nextDate ? `/model-royale/round/${nextDate}` : undefined,
  },
);
---

<BaseLayout seo={seo}>
  <Header subtitle={`round ${fmtDate(round.date)}`} />
  <RoyaleNav />

  <Masthead title={`round ${fmtDate(round.date)}`} subtitle={champ.score > 0 ? `<strong style="color:var(--accent)">${champ.impl}</strong> takes the round with <strong> ${fmtNum(champ.score, 1)}/30</strong> &mdash; spec ${fmtNum(champEntry?.specPeer ?? 0, 1)}, quality ${fmtNum(champEntry?.qualityPeer ?? 0, 1)}. ${modelCount} models, ${fmtCost(roundCost)} spent on outputs. Hidden tests: <span class="${allPassed ? 'win' : 'fail'}">${allPassed ? 'all passed' : 'some failures'}</span>.` : undefined} />

  {notesForRound.length > 0 && (
    <section class="writeup-callout">
      {notesForRound.map(n => (
        <a href={`/model-royale/writeups/${n.id}`} class="writeup-card">
          <span class="writeup-tag">writeup</span>
          <span class="writeup-title">{n.data.title}</span>
          <span class="writeup-summary">{n.data.summary}</span>
          <span class="writeup-arrow">→</span>
        </a>
      ))}
    </section>
  )}

  <div class="tabs" role="tablist" aria-label="Round sections">
    <button class="tab" role="tab" id="tab-scoreboard" data-tab="scoreboard" aria-selected="true" aria-controls="panel-scoreboard">scoreboard</button>
    <button class="tab" role="tab" id="tab-runs" data-tab="runs" aria-selected="false" aria-controls="panel-runs">runs</button>
    <button class="tab" role="tab" id="tab-self-bias" data-tab="self-bias" aria-selected="false" aria-controls="panel-self-bias">self-bias</button>
    <button class="tab" role="tab" id="tab-judges" data-tab="judges" aria-selected="false" aria-controls="panel-judges">judges</button>
    <button class="tab" role="tab" id="tab-agreement" data-tab="agreement" aria-selected="false" aria-controls="panel-agreement">agreement</button>
    <button class="tab" role="tab" id="tab-per-impl" data-tab="per-impl" aria-selected="false" aria-controls="panel-per-impl">per-impl</button>
    <button class="tab" role="tab" id="tab-cost" data-tab="cost" aria-selected="false" aria-controls="panel-cost">cost</button>
  </div>

  <div class="tab-panels">
    <div class="tab-panel" role="tabpanel" id="panel-scoreboard" data-panel="scoreboard" aria-labelledby="tab-scoreboard">
      <Scoreboard entries={round.scoreboard} champion={champ.impl} slugs={slugs} />
      <div class="chart-block">
        <RoundBars date={round.date} />
      </div>
    </div>
    <div class="tab-panel" role="tabpanel" id="panel-runs" data-panel="runs" hidden aria-labelledby="tab-runs">
      <RunsTable runs={round.samples} slugs={slugs} />
    </div>
    <div class="tab-panel" role="tabpanel" id="panel-self-bias" data-panel="self-bias" hidden aria-labelledby="tab-self-bias">
      <SelfBias entries={round.selfBias} slugs={slugs} />
    </div>
    <div class="tab-panel" role="tabpanel" id="panel-judges" data-panel="judges" hidden aria-labelledby="tab-judges">
      <JudgeRanking entries={round.judgeRanking} slugs={slugs} />
    </div>
    <div class="tab-panel" role="tabpanel" id="panel-agreement" data-panel="agreement" hidden aria-labelledby="tab-agreement">
      <Agreement entries={round.agreement} slugs={slugs} />
    </div>
    <div class="tab-panel" role="tabpanel" id="panel-per-impl" data-panel="per-impl" hidden aria-labelledby="tab-per-impl">
      <PerImplDetail entries={round.perImplDetail} date={round.date} slugs={slugs} />
    </div>
    <div class="tab-panel" role="tabpanel" id="panel-cost" data-panel="cost" hidden aria-labelledby="tab-cost">
      <CostEfficiency entries={round.costEfficiency} />
      <div class="chart-block">
        <RoundScatter date={round.date} />
      </div>
    </div>
  </div>

  <script>
    import { initTabs } from '../../../../scripts/tabs';
    initTabs('scoreboard');
  </script>
  <Footer />
</BaseLayout>

<style>
  .writeup-callout { display: flex; flex-direction: column; gap: 8px; margin: 16px 0 24px; }
  .writeup-card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'tag title arrow' 'tag summary arrow';
    gap: 4px 16px;
    padding: 12px 16px;
    border-left: 3px solid var(--accent);
    background: var(--bg-alt);
    color: var(--fg);
    text-decoration: none;
    align-items: center;
  }
  .writeup-card:hover { background: var(--code-bg); }
  .writeup-tag { grid-area: tag; font-family: var(--mono); font-size: var(--font-xs); text-transform: uppercase; color: var(--accent); letter-spacing: 0.08em; }
  .writeup-title { grid-area: title; font-weight: 700; color: var(--fg-bright); }
  .writeup-summary { grid-area: summary; color: var(--muted); font-size: var(--font-sm); }
  .writeup-arrow { grid-area: arrow; color: var(--accent); font-size: 1.4rem; }
  .chart-block { margin: 28px 0 8px; }
</style>