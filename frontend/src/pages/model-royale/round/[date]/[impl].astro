---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Header.astro';
import RoyaleNav from "../../../../components/RoyaleNav.astro";
import Footer from '../../../../components/Footer.astro';
import Masthead from '../../../../components/Masthead.astro';
import BackToTop from '../../../../components/BackToTop.astro';
import { getRoyaleRounds } from '../../../../lib/royale';
import { pickCanonicalRun, type RunArtifacts } from '../../../../lib/runs';
import { highlight } from '../../../../lib/highlight';
import { fmtCost, fmtSec, fmtTok, fmtDate, passFailIcon, passFailClass } from '../../../../lib/format';
import { renderMarkdown } from '../../../../lib/markdown';
import { templateSeo } from '../../../../lib/seo';
import { displaySlug } from '../../../../lib/slugs';

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getRoyaleRounds();
  const out: Array<{ params: { date: string; impl: string }; props: { artifacts: RunArtifacts; date: string; impl: string; runPathHint: string | null; allImpls: string[] } }> = [];
  for (const entry of entries) {
    const r = entry.data;
    const collected = new Map<string, { artifacts: RunArtifacts; runPathHint: string | null }>();
    for (const detail of r.perImplDetail) {
      if (collected.has(detail.impl)) continue;
      const artifacts = pickCanonicalRun(detail.impl, r.date, detail.runPath);
      if (!artifacts) continue;
      collected.set(detail.impl, { artifacts, runPathHint: detail.runPath });
    }
    for (const sample of r.samples) {
      if (collected.has(sample.model)) continue;
      const artifacts = pickCanonicalRun(sample.model, r.date);
      if (!artifacts) continue;
      collected.set(sample.model, { artifacts, runPathHint: null });
    }
    const allImpls = [...collected.keys()];
    for (const [impl, { artifacts, runPathHint }] of collected) {
      out.push({ params: { date: r.date, impl }, props: { artifacts, date: r.date, impl, runPathHint, allImpls } });
    }
  }
  return out;
}

const { artifacts, date, impl, allImpls } = Astro.props;
const meta = artifacts.meta;

const sandboxHtml = artifacts.sandboxPy ? await highlight(artifacts.sandboxPy, 'python') : null;
const diffHtml = artifacts.diffPatch ? await highlight(artifacts.diffPatch, 'diff') : null;
const testHtml = artifacts.testOutput ? await highlight(artifacts.testOutput, 'shellsession') : null;
const transcriptHtml = artifacts.transcript ? renderMarkdown(artifacts.transcript) : null;

const sandboxLineCount = artifacts.sandboxPy?.split('\n').length ?? 0;
const transcriptByteSize = artifacts.transcript ? new TextEncoder().encode(artifacts.transcript).length : 0;
const firstTab = sandboxHtml ? 'code' : diffHtml ? 'diff' : testHtml ? 'tests' : transcriptHtml ? 'transcript' : 'code';

const canonicalPath = `/model-royale/round/${date}/${impl}`;
const trail = [
  { name: 'open-bench', path: '/' },
  { name: `round ${date}`, path: `/model-royale/round/${date}` },
  { name: impl, path: canonicalPath },
];
const seo = templateSeo(
  'impl',
  canonicalPath,
  { date, impl },
  { impl, date, canonicalPath, trail },
  date,
);
---

<BaseLayout seo={seo}>
  <Header subtitle={`${impl} / ${fmtDate(date)}`} />
  <RoyaleNav />

  <div style="margin:12px 0 0">
    <a href={`/model-royale/round/${date}`} class="back-link-arrow">&larr; back to round {fmtDate(date)}</a>
  </div>

  <nav class="model-tabs" aria-label="Models in round">
    {allImpls.map(name => (
      <a
        href={`/model-royale/round/${date}/${name}`}
        class:list={['model-tab', { active: name === impl }]}
        aria-current={name === impl ? 'page' : undefined}
        data-impl={name}
        transition:name={name === impl ? `impl-${date}-${name}` : undefined}
      >{name}</a>
    ))}
  </nav>

  <script>
    document.querySelectorAll<HTMLAnchorElement>('.model-tab').forEach(a => {
      a.addEventListener('click', () => {
        const hash = location.hash;
        if (hash) a.setAttribute('href', a.getAttribute('href')!.split('#')[0] + hash);
      });
    });
  </script>

  <Masthead title={impl} titleTransitionName={`impl-${date}-${impl}`} subtitle={`<span class="muted" style="font-size:var(--font-sm)">${artifacts.runPath}</span>${meta?.modelSlug ? `<div style="margin-top:4px;font-size:var(--font-sm)"><span class="muted">model:</span> <code>${displaySlug(meta.modelSlug)}</code></div>` : ''}`} />

  <div class="run-stats">
    <div class="run-stat"><div class="run-stat-label">wall</div><div class="run-stat-val">{fmtSec(meta?.wallSec ?? null)}</div></div>
    <div class="run-stat"><div class="run-stat-label">cost</div><div class="run-stat-val">{fmtCost(meta?.costUsd ?? null)}</div></div>
    <div class="run-stat"><div class="run-stat-label">tokens</div><div class="run-stat-val">{fmtTok(meta?.tokensTotal ?? null)}</div></div>
    <div class="run-stat"><div class="run-stat-label">loc</div><div class="run-stat-val">{meta?.loc ?? '—'}</div></div>
    <div class="run-stat">
      <div class="run-stat-label">tests</div>
      <div class="run-stat-val">
        <span class:list={[passFailClass(meta?.testExitCode ?? null)]}>{passFailIcon(meta?.testExitCode ?? null)}</span>
      </div>
    </div>
  </div>

  <div class="tabs" role="tablist" aria-label="Run sections">
    {sandboxHtml && <button class="tab" role="tab" id="tab-code" data-tab="code" aria-selected={firstTab === 'code' ? 'true' : 'false'} aria-controls="panel-code">code</button>}
    {diffHtml && <button class="tab" role="tab" id="tab-diff" data-tab="diff" aria-selected={firstTab === 'diff' ? 'true' : 'false'} aria-controls="panel-diff">diff</button>}
    {testHtml && <button class="tab" role="tab" id="tab-tests" data-tab="tests" aria-selected={firstTab === 'tests' ? 'true' : 'false'} aria-controls="panel-tests">tests</button>}
    {transcriptHtml && <button class="tab" role="tab" id="tab-transcript" data-tab="transcript" aria-selected={firstTab === 'transcript' ? 'true' : 'false'} aria-controls="panel-transcript">transcript</button>}
  </div>

  <div class="tab-panels">
    {sandboxHtml && (
      <div class="tab-panel" role="tabpanel" id="panel-code" data-panel="code" aria-labelledby="tab-code">
        <p class="muted section-subtitle">sandbox.py · {sandboxLineCount} lines</p>
        <div class="code-block" set:html={sandboxHtml} />
      </div>
    )}
    {diffHtml && (
      <div class="tab-panel" role="tabpanel" id="panel-diff" data-panel="diff" hidden aria-labelledby="tab-diff">
        <p class="muted section-subtitle">diff.patch</p>
        <div class="code-block" set:html={diffHtml} />
      </div>
    )}
    {testHtml && (
      <div class="tab-panel" role="tabpanel" id="panel-tests" data-panel="tests" hidden aria-labelledby="tab-tests">
        <p class="muted section-subtitle">pytest output (hidden tests)</p>
        <div class="code-block" set:html={testHtml} />
      </div>
    )}
    {transcriptHtml && (
      <div class="tab-panel" role="tabpanel" id="panel-transcript" data-panel="transcript" hidden aria-labelledby="tab-transcript">
        <p class="muted section-subtitle">session transcript · {(transcriptByteSize / 1024).toFixed(0)}kb</p>
        <div class="prose transcript-prose" set:html={transcriptHtml} />
      </div>
    )}
  </div>

  <script>
    import { initTabs } from '../../../../scripts/tabs';
    initTabs();
  </script>

  <BackToTop />
  <Footer />
</BaseLayout>