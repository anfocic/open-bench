---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import RoyaleNav from "../../components/RoyaleNav.astro";
import Footer from '../../components/Footer.astro';
import Masthead from '../../components/Masthead.astro';
import { getCollection } from 'astro:content';
import { fmtCost, fmtNum } from '../../lib/format';
import { computeStandings, sparkline } from '../../lib/aggregate';
import { pageSeo } from '../../lib/seo';
import Term from '../../components/Term.astro';

const entries = await getCollection('rounds');
const rounds = entries.map(e => e.data);
const standings = computeStandings(rounds);
const totalRounds = rounds.length;

const seo = pageSeo('leaderboard', '/model-royale/leaderboard', {
  standings: standings.map(s => ({ impl: s.impl, elo: s.elo })),
});
---

<BaseLayout seo={seo}>
  <Header subtitle="leaderboard" />
  <RoyaleNav />
  <Masthead title="leaderboard" subtitle={`Cumulative standings across ${totalRounds} round${totalRounds === 1 ? '' : 's'}. ELO base 1000, K=32. Hard-failed runs excluded from ranking.`}>
    {standings.length >= 2 && <p class="masthead-meta"><a href="/model-royale/compare">compare two models &rarr;</a></p>}
  </Masthead>

  <section>
    {standings.length === 0 ? (
      <p class="muted">No rounds yet.</p>
    ) : (
      <table class="leaderboard">
        <thead>
          <tr>
            <th class="num">#</th>
            <th>model</th>
            <th class="num"><Term k="elo">elo</Term></th>
            <th class="num">rounds</th>
            <th class="num">wins</th>
            <th class="num"><Term k="podium">podium</Term></th>
            <th class="num"><Term k="avg">avg</Term></th>
            <th class="num"><Term k="costPerRound">$/round</Term></th>
            <th><Term k="trend">trend</Term></th>
          </tr>
        </thead>
        <tbody>
          {standings.map((s, i) => (
            <tr>
              <td class="num">{i + 1}</td>
              <td><a href={`/model-royale/model/${s.impl}`} transition:name={`model-${s.impl}`}>{s.impl}</a></td>
              <td class="num"><strong>{Math.round(s.elo)}</strong></td>
              <td class="num">{s.rounds}</td>
              <td class="num">{s.wins}</td>
              <td class="num">{s.podium}</td>
              <td class="num">{fmtNum(s.avgScore, 1)}</td>
              <td class="num">{fmtCost(s.avgCost)}</td>
              <td class="spark">{sparkline(s.history)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </section>

  <Footer />
</BaseLayout>

<style>
  .leaderboard { width: 100%; border-collapse: collapse; }
  .leaderboard th, .leaderboard td { padding: 6px 10px; border-bottom: 1px solid var(--rule); }
  .leaderboard .num { text-align: right; font-variant-numeric: tabular-nums; }
  .leaderboard .spark { font-family: var(--mono); letter-spacing: -1px; color: var(--accent); }
  .leaderboard tbody tr:hover { background: var(--bg-alt); }
</style>
