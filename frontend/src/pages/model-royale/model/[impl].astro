---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import RoyaleNav from "../../../components/RoyaleNav.astro";
import Footer from '../../../components/Footer.astro';
import Masthead from '../../../components/Masthead.astro';
import { getCollection } from 'astro:content';
import { fmtCost, fmtNum, fmtDate } from '../../../lib/format';
import { computeStandings, computeBias, sparkline } from '../../../lib/aggregate';
import { templateSeo } from '../../../lib/seo';
import Term from '../../../components/Term.astro';

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getCollection('rounds');
  const rounds = entries.map(e => e.data);
  const impls = new Set<string>();
  for (const r of rounds) for (const e of r.scoreboard) impls.add(e.impl);
  return [...impls].map(impl => ({ params: { impl }, props: { impl } }));
}

const { impl } = Astro.props;
const entries = await getCollection('rounds');
const rounds = entries.map(e => e.data);
const standings = computeStandings(rounds);
const standing = standings.find(s => s.impl === impl);
if (!standing) return Astro.redirect('/404');

const rank = standings.findIndex(s => s.impl === impl) + 1;
const canonicalPath = `/model-royale/model/${impl}`;
const seo = templateSeo(
  'model',
  canonicalPath,
  {
    impl,
    rounds: standing.rounds,
    roundSuffix: standing.rounds === 1 ? '' : 's',
    wins: standing.wins,
    winSuffix: standing.wins === 1 ? '' : 's',
    elo: Math.round(standing.elo),
    totalCost: fmtNum(standing.totalCost, 2),
  },
  { trail: [
    { name: 'open-bench', path: '/' },
    { name: 'leaderboard', path: '/model-royale/leaderboard' },
    { name: impl, path: canonicalPath },
  ] },
);

const history = [...standing.history].sort((a, b) => b.date.localeCompare(a.date));
const bias = computeBias(impl, rounds);
const biasByDate = new Map(bias.perRound.map(b => [b.date, b]));

const fmtDelta = (v: number | null): string => {
  if (v === null) return '—';
  const sign = v > 0 ? '+' : '';
  return `${sign}${v.toFixed(1)}`;
};

const finished = standing.history.filter(h => !h.dnf);
const hardFailCount = standing.history.length - finished.length;
const bestRound = finished.length
  ? finished.reduce((best, h) => (h.score > best.score ? h : best))
  : null;
const worstRound = finished.length
  ? finished.reduce((worst, h) => (h.score < worst.score ? h : worst))
  : null;
---

<BaseLayout seo={seo}>
  <Header subtitle={impl} />
  <RoyaleNav />
  <Masthead title={impl} titleTransitionName={`model-${impl}`} subtitle={`Rank <strong>#${rank}</strong> &middot; ELO <strong>${Math.round(standing.elo)}</strong> &middot; ${standing.wins} win${standing.wins === 1 ? '' : 's'} in ${standing.rounds} round${standing.rounds === 1 ? '' : 's'} &middot; ${fmtCost(standing.totalCost)} total spend`}>
    <div class="masthead-meta">
      <span>podium {standing.podium}</span>
      <span>avg {fmtNum(standing.avgScore, 1)}/30</span>
      <span>$/round {fmtCost(standing.avgCost)}</span>
      <span title="Lifetime average self-vs-peer delta on spec compliance. Positive = overrates own work; negative = underrates.">
        Δ self/peer (spec) {fmtDelta(bias.avgDeltaSpec)}
      </span>
      <span title="Lifetime average self-vs-peer delta on code quality.">
        Δ self/peer (qual) {fmtDelta(bias.avgDeltaQual)}
      </span>
      <span>last {fmtDate(standing.lastSeen)}</span>
      <span class="trend">{sparkline(standing.history)}</span>
    </div>
    <div class="masthead-meta">
      {bestRound && (
        <span title={`Best score: ${fmtNum(bestRound.score, 1)}/30 in ${fmtDate(bestRound.date)}.`}>
          best {fmtNum(bestRound.score, 1)} ({fmtDate(bestRound.date)})
        </span>
      )}
      {worstRound && worstRound.date !== bestRound?.date && (
        <span title={`Worst non-DNF score: ${fmtNum(worstRound.score, 1)}/30 in ${fmtDate(worstRound.date)}.`}>
          worst {fmtNum(worstRound.score, 1)} ({fmtDate(worstRound.date)})
        </span>
      )}
      <span title="Hidden-test failures across all rounds — model produced something the hidden tests rejected.">
        hard-fails {hardFailCount}/{standing.history.length}
      </span>
    </div>
  </Masthead>

  <section>
    <h2>history</h2>
    <table class="model-history">
      <thead>
        <tr>
          <th>round</th>
          <th class="num"><Term k="score">score</Term></th>
          <th class="num"><Term k="rank">rank</Term></th>
          <th class="num">cost</th>
          <th class="num" title="Self-judgment minus peer median for that round.">Δ spec</th>
          <th class="num" title="Self-judgment minus peer median on code quality for that round.">Δ qual</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {history.map(h => {
          const b = biasByDate.get(h.date);
          return (
            <tr class={h.dnf ? 'hardfail' : ''}>
              <td>{fmtDate(h.date)}</td>
              <td class="num">{h.dnf ? '—' : `${fmtNum(h.score, 1)}/30`}</td>
              <td class="num">{h.dnf ? 'DNF' : `#${h.rank}`}</td>
              <td class="num">{fmtCost(h.cost)}</td>
              <td class="num">{fmtDelta(b?.deltaSpec ?? null)}</td>
              <td class="num">{fmtDelta(b?.deltaQual ?? null)}</td>
              <td><a href={`/model-royale/round/${h.date}`}>view round &rarr;</a></td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </section>

  <section>
    <p><a href="/model-royale/leaderboard">&larr; back to leaderboard</a></p>
  </section>

  <Footer />
</BaseLayout>

<style>
  .model-history { width: 100%; border-collapse: collapse; }
  .model-history th, .model-history td { padding: 6px 10px; border-bottom: 1px solid var(--rule); }
  .model-history .num { text-align: right; font-variant-numeric: tabular-nums; }
  .model-history tr.hardfail { color: var(--muted); }
  .trend { font-family: var(--mono); letter-spacing: -1px; color: var(--accent); }
</style>
