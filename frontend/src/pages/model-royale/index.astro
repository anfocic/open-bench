---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import RoyaleNav from "../../components/RoyaleNav.astro";
import Footer from '../../components/Footer.astro';
import Masthead from '../../components/Masthead.astro';
import { getRoyaleRounds, ROYALE_TASK } from '../../lib/royale';
import { resolve } from 'node:path';
import { repoRoot } from '../../lib/paths';
import { fmtCost, fmtNum, fmtDate } from '../../lib/format';
import { findChampion, uniqueModelCount, totalCost } from '../../lib/scoreboard';
import { computeStandings } from '../../lib/aggregate';
import { readJsonOptional, readOptional } from '../../lib/io';
import { pageSeo } from '../../lib/seo';
import { displaySlug } from '../../lib/slugs';

interface Config {
  implementers: string[];
  expert_judges?: string[];
  slugs: Record<string, string>;
}
interface TaskMeta {
  entrypoint?: string;
  language?: string;
  test_runner?: string;
}

const cfg = readJsonOptional<Config>(resolve(repoRoot, 'bench/config.json')) ?? {
  implementers: [], expert_judges: [], slugs: {},
};

const entries = await getRoyaleRounds();
const rounds = entries.sort((a, b) => b.id.localeCompare(a.id)).map(e => e.data);
const latestRound = rounds[0];
const currentTask = latestRound?.task ?? ROYALE_TASK;
const taskMeta = readJsonOptional<TaskMeta>(
  resolve(repoRoot, 'bench/tasks', currentTask, 'task.json'),
) ?? {};
const specRaw = readOptional(resolve(repoRoot, 'bench/tasks', currentTask, 'SPEC.md')) ?? '';
const specPitch = (() => {
  const lines = specRaw.split('\n');
  const out: string[] = [];
  let started = false;
  for (const ln of lines) {
    if (!started) {
      if (!ln.trim() || ln.startsWith('#')) continue;
      started = true;
    }
    if (!ln.trim()) break;
    out.push(ln.trim());
  }
  return out.join(' ');
})();

const top3 = computeStandings(rounds).slice(0, 3);
const champ = latestRound ? findChampion(latestRound.scoreboard) : { impl: '—', score: 0 };
const champEntry = latestRound?.scoreboard.find(e => e.impl === champ.impl);
const modelCount = latestRound ? uniqueModelCount(latestRound.samples) : 0;
const latestCost = latestRound ? totalCost(latestRound.samples) : 0;
const totalSamples = rounds.reduce((sum, r) => sum + r.samples.length, 0);
const totalSpend = rounds.reduce((sum, r) => sum + totalCost(r.samples), 0);

const seo = pageSeo('modelRoyale', '/model-royale');
---

<BaseLayout seo={seo}>
  <Header subtitle="model royale" />
  <RoyaleNav />

  <Masthead title="model royale" subtitle={`Weekly elimination tournament across selected open-source coding models. Same blank repo, same SPEC.md, same hidden tests. Models judge each other. Loser is cut, a challenger is called up. Runs on the <a href="/">open-bench</a> engine.`} />

  <section class="hero-stats">
    <div class="stat"><span class="stat-num">{rounds.length}</span><span class="stat-label">round{rounds.length === 1 ? '' : 's'}</span></div>
    <div class="stat"><span class="stat-num">{cfg.implementers.length}</span><span class="stat-label">models</span></div>
    <div class="stat"><span class="stat-num">{totalSamples}</span><span class="stat-label">samples</span></div>
    <div class="stat"><span class="stat-num">{fmtCost(totalSpend)}</span><span class="stat-label">total spend</span></div>
    <div class="stat"><span class="stat-num">{latestRound ? fmtDate(latestRound.date) : '—'}</span><span class="stat-label">last round</span></div>
  </section>

  {top3.length > 0 && (
    <section>
      <div class="section-head">
        <h2>standings</h2>
        <a class="section-link" href="/model-royale/leaderboard">full leaderboard &rarr;</a>
      </div>
      <ol class="podium">
        {top3.map((s, i) => (
          <li class={`podium-card podium-${i + 1}`}>
            <div class="podium-rank">#{i + 1}</div>
            <div class="podium-id">
              <a href={`/model-royale/model/${s.impl}`} class="podium-name">{s.impl}</a>
              {cfg.slugs[s.impl] && <span class="podium-slug">{displaySlug(cfg.slugs[s.impl])}</span>}
            </div>
            <div class="podium-meta">
              <span class="podium-elo">{Math.round(s.elo)}</span>
              <span class="podium-elo-label">ELO</span>
            </div>
            <dl class="podium-stats">
              <div><dt>wins</dt><dd>{s.wins}</dd></div>
              <div><dt>podium</dt><dd>{s.podium}</dd></div>
              <div><dt>avg</dt><dd>{fmtNum(s.avgScore, 1)}</dd></div>
            </dl>
          </li>
        ))}
      </ol>
    </section>
  )}

  {latestRound && champ.score > 0 && (
    <section>
      <div class="section-head">
        <h2>latest round</h2>
        <a class="section-link" href={`/model-royale/round/${latestRound.date}`}>view round &rarr;</a>
      </div>
      <a href={`/model-royale/round/${latestRound.date}`} class="round-card">
        <div class="round-card-date">
          <span class="round-card-label">round</span>
          <span class="round-card-when">{fmtDate(latestRound.date)}</span>
        </div>
        <div class="round-card-winner">
          <span class="round-card-label">winner</span>
          <span class="round-card-impl">{champ.impl}</span>
          {cfg.slugs[champ.impl] && <span class="round-card-slug">{displaySlug(cfg.slugs[champ.impl])}</span>}
        </div>
        <div class="round-card-score">
          <span class="round-card-num">{fmtNum(champ.score, 1)}</span>
          <span class="round-card-denom">/30</span>
          <span class="round-card-breakdown">spec {fmtNum(champEntry?.specPeer ?? 0, 1)} &middot; qual {fmtNum(champEntry?.qualityPeer ?? 0, 1)}</span>
        </div>
        <div class="round-card-meta">
          <span><strong>{modelCount}</strong> models</span>
          <span><strong>{fmtCost(latestCost)}</strong> spent</span>
        </div>
      </a>
    </section>
  )}

  <section>
    <div class="section-head">
      <h2>current task</h2>
      <a class="section-link" href={`/task/${currentTask}`}>full spec &rarr;</a>
    </div>
    <div class="task-card">
      <h3 class="task-name">{currentTask}</h3>
      <p class="task-pitch">{specPitch}</p>
      <dl class="defs">
        <div><dt>entrypoint</dt><dd>{taskMeta.entrypoint ?? '—'}</dd></div>
        <div><dt>language</dt><dd>{taskMeta.language ?? '—'}</dd></div>
        <div><dt>test runner</dt><dd>{taskMeta.test_runner ?? '—'}</dd></div>
      </dl>
    </div>
  </section>

  <section>
    <div class="section-head">
      <h2>lineup</h2>
      <span class="section-link muted">{cfg.implementers.length} contenders &middot; every implementer is also a peer judge</span>
    </div>
    <div class="lineup-grid">
      {cfg.implementers.map(impl => (
        <a class="lineup-card" href={`/model-royale/model/${impl}`}>
          <span class="lineup-name">{impl}</span>
          <span class="lineup-slug">{displaySlug(cfg.slugs[impl]) || '—'}</span>
        </a>
      ))}
    </div>
  </section>

  <section>
    <p class="muted footer-links">
      <a href="/model-royale/rules">rules &rarr;</a>
      <span class="sep">|</span>
      <a href="/model-royale/round">all rounds &rarr;</a>
      <span class="sep">|</span>
      <a href="/model-royale/leaderboard">full leaderboard &rarr;</a>
      <span class="sep">|</span>
      <a href="/model-royale/compare">compare models &rarr;</a>
    </p>
  </section>

  <Footer />
</BaseLayout>

<style>
  section + section { margin-top: 2.5rem; }
  .section-head { margin-bottom: 1.25rem; }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    margin: 1.5rem 0 2rem;
  }
  .stat {
    background: var(--bg);
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .stat-num { font-family: var(--mono); font-size: 1.4rem; color: var(--fg-bright); font-weight: 600; font-variant-numeric: tabular-nums; }
  .stat-label { font-size: var(--font-xs); color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 1rem;
    padding-bottom: 0.4rem;
  }
  .section-head h2 { margin: 0; border: none; padding: 0; }
  .section-link { font-size: var(--font-sm); }

  .podium {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  @media (max-width: 720px) { .podium { grid-template-columns: 1fr; } }
  .podium-card {
    border: 1px solid var(--rule);
    padding: 14px 16px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'rank id meta' 'stats stats stats';
    align-items: center;
    gap: 0.5rem 1rem;
  }
  .podium-1 { border-color: var(--accent); background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 8%, transparent), transparent); }
  .podium-2 { border-color: color-mix(in srgb, var(--accent) 60%, var(--rule)); }
  .podium-rank {
    grid-area: rank;
    font-family: var(--mono);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--accent);
  }
  .podium-id { grid-area: id; display: flex; flex-direction: column; line-height: 1.2; min-width: 0; }
  .podium-name { font-weight: 700; color: var(--fg-bright); }
  .podium-slug { font-family: var(--mono); font-size: var(--font-xs); color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .podium-meta { grid-area: meta; text-align: right; line-height: 1; }
  .podium-elo { font-family: var(--mono); font-size: 1.2rem; font-weight: 700; color: var(--fg-bright); display: block; font-variant-numeric: tabular-nums; }
  .podium-elo-label { font-size: var(--font-xs); color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
  .podium-stats {
    grid-area: stats;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    margin: 0.5rem 0 0;
    padding-top: 0.5rem;
    border-top: 1px dashed var(--rule);
  }
  .podium-stats div { display: flex; flex-direction: column; }
  .podium-stats dt { font-size: var(--font-xs); color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; }
  .podium-stats dd { margin: 0; font-family: var(--mono); font-variant-numeric: tabular-nums; color: var(--fg-bright); }

  .round-card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'date winner score' 'meta meta meta';
    gap: 0.75rem 1.5rem;
    padding: 16px 20px;
    border: 1px solid var(--rule);
    border-left: 3px solid var(--accent);
    text-decoration: none;
    color: var(--fg);
    align-items: center;
  }
  .round-card:hover { background: var(--bg-alt); }
  .round-card-date { grid-area: date; display: flex; flex-direction: column; line-height: 1.2; }
  .round-card-winner { grid-area: winner; display: flex; flex-direction: column; line-height: 1.2; }
  .round-card-score { grid-area: score; text-align: right; line-height: 1.2; }
  .round-card-label { font-size: var(--font-xs); color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
  .round-card-when { font-family: var(--mono); font-size: 1.1rem; font-weight: 600; color: var(--fg-bright); }
  .round-card-impl { font-weight: 700; color: var(--accent); font-size: 1.05rem; }
  .round-card-slug { font-family: var(--mono); font-size: var(--font-xs); color: var(--muted); }
  .round-card-num { font-family: var(--mono); font-size: 1.6rem; font-weight: 700; color: var(--fg-bright); }
  .round-card-denom { font-family: var(--mono); color: var(--muted); }
  .round-card-breakdown { display: block; font-size: var(--font-xs); color: var(--muted); margin-top: 2px; }
  .round-card-meta {
    grid-area: meta;
    padding-top: 0.5rem;
    border-top: 1px dashed var(--rule);
    display: flex;
    gap: 1.5rem;
    font-size: var(--font-sm);
    color: var(--muted);
  }
  .round-card-meta strong { color: var(--fg-bright); font-family: var(--mono); font-weight: 600; }
  @media (max-width: 600px) {
    .round-card { grid-template-columns: 1fr; grid-template-areas: 'date' 'winner' 'score' 'meta'; }
    .round-card-score { text-align: left; }
  }

  .task-card {
    border: 1px solid var(--rule);
    padding: 14px 18px;
  }
  .task-name { margin: 0 0 0.5rem; font-family: var(--mono); color: var(--accent); }
  .task-pitch { margin: 0 0 1rem; color: var(--fg-bright); }
  .defs { display: grid; gap: 0.5rem; margin: 0; }
  .defs > div { display: grid; grid-template-columns: 8rem 1fr; gap: 1rem; }
  .defs dt { font-size: var(--font-xs); color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; align-self: center; }
  .defs dd { margin: 0; font-family: var(--mono); }

  .lineup-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 10px;
  }
  .lineup-card {
    display: flex;
    flex-direction: column;
    padding: 10px 14px;
    border: 1px solid var(--rule);
    text-decoration: none;
    color: var(--fg);
    line-height: 1.2;
    gap: 2px;
  }
  .lineup-card:hover { border-color: var(--accent); background: var(--bg-alt); }
  .lineup-name { font-weight: 600; color: var(--fg-bright); }
  .lineup-slug { font-family: var(--mono); font-size: var(--font-xs); color: var(--muted); }

  .footer-links { text-align: center; padding-top: 1.5rem; }
  .footer-links .sep { margin: 0 0.5rem; color: var(--muted); }
</style>
