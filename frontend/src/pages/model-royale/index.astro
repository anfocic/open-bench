---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import RoyaleNav from "../../components/RoyaleNav.astro";
import Footer from '../../components/Footer.astro';
import Masthead from '../../components/Masthead.astro';
import { getCollection } from 'astro:content';
import { resolve } from 'node:path';
import { repoRoot } from '../../lib/paths';
import { fmtCost, fmtNum, fmtDate } from '../../lib/format';
import { findChampion, uniqueModelCount, totalCost } from '../../lib/scoreboard';
import { computeStandings } from '../../lib/aggregate';
import { readJsonOptional, readOptional, listDirs } from '../../lib/io';
import { pageSeo } from '../../lib/seo';

interface Config {
  implementers: string[];
  expert_judges?: string[];
  slugs: Record<string, string>;
}
interface TaskMeta {
  entrypoint?: string;
  language?: string;
  test_runner?: string;
}

const cfg = readJsonOptional<Config>(resolve(repoRoot, 'bench/config.json')) ?? {
  implementers: [], expert_judges: [], slugs: {},
};

const tasks = listDirs(resolve(repoRoot, 'bench/tasks'));
const currentTask = tasks[0] ?? 'sandbox';
const taskMeta = readJsonOptional<TaskMeta>(
  resolve(repoRoot, 'bench/tasks', currentTask, 'task.json'),
) ?? {};
const specRaw = readOptional(resolve(repoRoot, 'bench/tasks', currentTask, 'SPEC.md')) ?? '';
const specPitch = (() => {
  const lines = specRaw.split('\n');
  const out: string[] = [];
  let started = false;
  for (const ln of lines) {
    if (!started) {
      if (!ln.trim() || ln.startsWith('#')) continue;
      started = true;
    }
    if (!ln.trim()) break;
    out.push(ln.trim());
  }
  return out.join(' ');
})();

const entries = await getCollection('rounds');
const rounds = entries.sort((a, b) => b.id.localeCompare(a.id)).map(e => e.data);
const latestRound = rounds[0];
const top3 = computeStandings(rounds).slice(0, 3);
const champ = latestRound ? findChampion(latestRound.scoreboard) : { impl: '—', score: 0 };
const champEntry = latestRound?.scoreboard.find(e => e.impl === champ.impl);
const modelCount = latestRound ? uniqueModelCount(latestRound.samples) : 0;
const latestCost = latestRound ? totalCost(latestRound.samples) : 0;
const totalSamples = rounds.reduce((sum, r) => sum + r.samples.length, 0);
const totalSpend = rounds.reduce((sum, r) => sum + totalCost(r.samples), 0);

const seo = pageSeo('modelRoyale', '/model-royale');
---

<BaseLayout seo={seo}>
  <Header subtitle="model royale" />
  <RoyaleNav />

  <Masthead title="model royale" subtitle={`Weekly elimination tournament across selected open-source coding models. Same blank repo, same SPEC.md, same hidden tests. Models judge each other. Loser is cut, a challenger is called up. Runs on the <a href="/">open-bench</a> engine.`}>
    <div class="masthead-meta">
      <span>{rounds.length} round{rounds.length === 1 ? '' : 's'}</span>
      <span>{cfg.implementers.length} models</span>
      <span>{totalSamples} samples</span>
      <span>{fmtCost(totalSpend)} spend</span>
      <span>last: {latestRound ? fmtDate(latestRound.date) : '—'}</span>
    </div>
  </Masthead>

  {top3.length > 0 && (
    <section>
      <h2>standings</h2>
      <div class="summary-line">
        {top3.map((s, i) => (
          <span>
            {i > 0 && <span class="sep">|</span>}
            <strong>#{i + 1}</strong> <a href={`/model-royale/model/${s.impl}`}>{s.impl}</a> <span class="muted">{Math.round(s.elo)} ELO</span>
          </span>
        ))}
        <span class="sep">|</span>
        <a href="/model-royale/leaderboard">full leaderboard &rarr;</a>
      </div>
    </section>
  )}

  {latestRound && champ.score > 0 && (
    <section>
      <h2>latest round</h2>
      <div class="summary-line">
        Round <strong>{fmtDate(latestRound.date)}</strong>
        <span class="sep">|</span>
        winner <strong>{champ.impl}</strong> at <strong>{fmtNum(champ.score, 1)}/30</strong>
        <span class="sep">|</span>
        spec {fmtNum(champEntry?.specPeer ?? 0, 1)}, quality {fmtNum(champEntry?.qualityPeer ?? 0, 1)}
        <span class="sep">|</span>
        {modelCount} models, {fmtCost(latestCost)} total &rarr;
        <a href={`/model-royale/round/${latestRound.date}`}>view round</a>
      </div>
    </section>
  )}

  <section>
    <h2>current task</h2>
    <p><strong>{currentTask}</strong> &mdash; {specPitch}</p>
    <dl class="defs">
      <div><dt>entrypoint</dt><dd>{taskMeta.entrypoint ?? '—'}</dd></div>
      <div><dt>language</dt><dd>{taskMeta.language ?? '—'}</dd></div>
      <div><dt>test runner</dt><dd>{taskMeta.test_runner ?? '—'}</dd></div>
    </dl>
    <p><a href={`/task/${currentTask}`}>{currentTask} &mdash; full spec, prompt, rubric &rarr;</a></p>
  </section>

  <section>
    <h2>lineup</h2>
    <p class="muted">Current contenders, pulled live from <code>bench/config.json</code>. Every implementer is also a peer judge.</p>
    <div class="lineup-list">
      {cfg.implementers.map(impl => (
        <div class="row">
          <span class="name">{impl}</span>
          <span class="slug">{cfg.slugs[impl] ?? '—'}</span>
        </div>
      ))}
    </div>
  </section>

  <section>
    <p class="muted">
      <a href="/model-royale/rules">rules &rarr;</a>
      <span class="sep">|</span>
      <a href="/model-royale/round">all rounds &rarr;</a>
      <span class="sep">|</span>
      <a href="/model-royale/leaderboard">full leaderboard &rarr;</a>
    </p>
  </section>

  <Footer />
</BaseLayout>

<style>
  .rules { padding-left: 1.25rem; }
  .rules li { padding: 0.25rem 0; }
  .defs { display: grid; gap: 0.5rem; margin: 0.5rem 0 1rem; }
  .defs > div { display: grid; grid-template-columns: 8rem 1fr; gap: 1rem; }
  .defs dt { font-weight: 600; }
  .defs dd { margin: 0; }
</style>
