---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Masthead from '../components/Masthead.astro';
import { fmtDate } from '../lib/format';
import { findChampion } from '../lib/scoreboard';
import { getCollection } from 'astro:content';
import type { SeoProps } from '../lib/seo';

const entries = await getCollection('rounds');
const rounds = entries.sort((a, b) => b.id.localeCompare(a.id)).map(e => e.data);
const latestRound = rounds[0];

const seo: SeoProps = {
  title: '404 · open-bench',
  description: 'Page not found.',
  ogImage: '/og-default.png',
  ogType: 'website',
  canonicalPath: '/404',
  jsonLd: [],
  noindex: true,
};
---

<BaseLayout seo={seo}>
  <Header subtitle="404" />
  <Masthead title="404" subtitle={latestRound ? `no such round, page, or path. try <a href="/benchmarks/${latestRound.task}/${latestRound.date}">${latestRound.task} ${latestRound.date}</a> or <a href="/">home</a>.` : 'no such round, page, or path.'} />
  {rounds.length > 0 && (
    <section>
      <h2>recent rounds</h2>
      <div class="archive-list">
        {rounds.slice(0, 5).map(r => {
          const c = findChampion(r.scoreboard);
          return (
            <a href={`/benchmarks/${r.task}/${r.date}`}>
              <div class="row">
                <span class="date">{fmtDate(r.date)}</span>
                <span class="winner">{r.task}</span>
                <span class="meta">{c.impl !== '—' ? c.impl : ''}</span>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )}
  <Footer />
</BaseLayout>
