---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="open-bench — 404" description="Page not found.">
  <Header subtitle="404" />
  <section class="masthead">
    <h1 class="masthead-title">404</h1>
    <p class="masthead-lede">no such round, page, or path.</p>
    <div class="masthead-meta">
      <a href="/">&larr; home</a>
    </div>
  </section>
  <Footer />
</BaseLayout>
