---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Masthead from '../../components/Masthead.astro';
import BackToTop from '../../components/BackToTop.astro';
import { resolve } from 'node:path';
import { repoRoot } from '../../lib/paths';
import { readOptional, listDirs } from '../../lib/io';
import { renderMarkdown } from '../../lib/markdown';

export async function getStaticPaths() {
  const tasksDir = resolve(repoRoot, 'bench/tasks');
  const names = listDirs(tasksDir);
  return names.map(name => ({ params: { task: name } }));
}

const { task } = Astro.params;
const taskDir = resolve(repoRoot, 'bench/tasks', task!);
const specRaw = readOptional(resolve(taskDir, 'SPEC.md'));
const promptRaw = readOptional(resolve(taskDir, 'PROMPT.md'));
const rubricRaw = readOptional(resolve(taskDir, 'JUDGE_RUBRIC.md'));
const specHtml = specRaw ? renderMarkdown(specRaw) : null;
const promptHtml = promptRaw ? renderMarkdown(promptRaw) : null;
const rubricHtml = rubricRaw ? renderMarkdown(rubricRaw) : null;
---

<BaseLayout title={`${task} task · open-bench`} description={`Full spec, prompt, and rubric for the ${task} task.`}>
  <Header subtitle={`task / ${task}`} />

  <Masthead title={task!} subtitle="The spec each model is given, plus the rubric judges use to score. Read it as a contract: what counts as done, what counts as good." />

  <div class="section-nav">
    {specHtml && <a href="#spec">spec</a>}
    {promptHtml && <a href="#prompt">prompt</a>}
    {rubricHtml && <a href="#rubric">rubric</a>}
  </div>

  {specHtml && (
    <section>
      <h2 id="spec">spec.md</h2>
      <div class="prose" set:html={specHtml} />
    </section>
  )}
  {promptHtml && (
    <section>
      <h2 id="prompt">prompt.md</h2>
      <div class="prose" set:html={promptHtml} />
    </section>
  )}
  {rubricHtml && (
    <section>
      <h2 id="rubric">judge_rubric.md</h2>
      <div class="prose" set:html={rubricHtml} />
    </section>
  )}

  <BackToTop />
  <Footer />
</BaseLayout>