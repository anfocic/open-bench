---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { resolve } from 'node:path';
import { repoRoot } from '../lib/paths';
import { readJsonOptional, readOptional, listDirs } from '../lib/io';
import { pageSeo } from '../lib/seo';
import '../styles/deck.css';

interface Config {
  implementers: string[];
  expert_judges?: string[];
  slugs: Record<string, string>;
}
interface TaskMeta {
  entrypoint?: string;
  language?: string;
  test_runner?: string;
}

const cfg = readJsonOptional<Config>(resolve(repoRoot, 'bench/config.json')) ?? {
  implementers: [], expert_judges: [], slugs: {},
};

const tasks = listDirs(resolve(repoRoot, 'bench/tasks'));
const currentTask = tasks[0] ?? 'sandbox';
const taskMeta = readJsonOptional<TaskMeta>(
  resolve(repoRoot, 'bench/tasks', currentTask, 'task.json'),
) ?? {};
const specRaw = readOptional(resolve(repoRoot, 'bench/tasks', currentTask, 'SPEC.md')) ?? '';
// Lift the first paragraph after the H1 as the pitch (skip blank lines + the H1 itself).
const specPitch = (() => {
  const lines = specRaw.split('\n');
  const out: string[] = [];
  let started = false;
  for (const ln of lines) {
    if (!started) {
      if (!ln.trim() || ln.startsWith('#')) continue;
      started = true;
    }
    if (!ln.trim()) break;
    out.push(ln.trim());
  }
  return out.join(' ');
})();

const sections = [
  {
    id: 'what',
    title: 'what',
    body: `<p><strong>Model Royale</strong> is a weekly elimination-style coding tournament. Selected open-source coding models show up to the same blank repo, the same <code>SPEC.md</code>, and the same hidden test suite. One task per round. One ranked review. One model gets cut; a challenger gets called up. Repeat.</p><p>It runs on the <a href="/about">open-bench</a> harness. open-bench is the framework — Model Royale is the format running on top of it.</p>`,
  },
  {
    id: 'rules',
    title: 'rules',
    steps: [
      'Same task, same spec, same wall-clock budget. Identical environment per model.',
      'Hidden pytest battery runs first. Fail it and you cannot win the round, no matter the judges.',
      'Every model judges every other implementation under blinded labels. Self-bias is measured, then excluded.',
      'Cost and wall-clock break ties. Cheapest-and-correct wins; slow-and-correct loses.',
      'The lowest-ranked model is eliminated from the lineup. A challenger is called up next round.',
    ],
  },
  {
    id: 'task',
    title: 'task',
    body: `<p><strong>${currentTask}</strong> &mdash; ${specPitch}</p>`,
    defs: [
      ['entrypoint', taskMeta.entrypoint ?? '—'],
      ['language', taskMeta.language ?? '—'],
      ['test runner', taskMeta.test_runner ?? '—'],
    ],
    links: [
      { href: `/task/${currentTask}`, label: `${currentTask} — full spec, prompt, rubric →`, note: '' },
    ],
  },
  {
    id: 'lineup',
    title: 'lineup',
    body: `<p>Current contenders, pulled live from <code>bench/config.json</code>. Every implementer is also a peer judge.</p>`,
    defs: cfg.implementers.map(name => [name, cfg.slugs[name] ?? '—']),
  },
  {
    id: 'why',
    title: 'why this format',
    body: `<p>Vendor leaderboards report pass@1 on synthetic problems and update on a marketing calendar. They tell you nothing about how a model behaves inside an agent loop where wall-clock, cost, and the readability of the diff matter as much as the answer.</p><p>Royale is opinionated about that gap. Hidden tests gate the qualitative scoring so we never reward broken-but-pretty code. Peer judging removes my taste from the qualitative axis. Cost is a first-class column, not a footnote. The week-on-week elimination keeps the lineup honest — there is no "leaderboard inertia" because the lineup itself rotates.</p>`,
  },
  {
    id: 'more',
    title: 'more',
    links: [
      { href: '/', label: 'latest round →', note: 'current scoreboard, judge rankings, hidden-test results' },
      { href: '/about', label: 'about open-bench', note: 'the harness underneath' },
      { href: 'https://github.com/anfocic/open-bench/blob/main/ABOUT.md', label: 'ABOUT.md', note: 'methodology, scoring math, task config' },
      { href: 'https://github.com/anfocic/open-bench/tree/main/results/reviews', label: 'results/reviews', note: 'every aggregated round' },
      { href: 'https://github.com/anfocic/open-bench/tree/main/builds', label: 'builds/', note: 'per-model artifacts and transcripts' },
    ],
  },
];
---

<BaseLayout seo={pageSeo('modelRoyale', '/model-royale')}>
  <Header subtitle="model royale" />

  <nav class="deck-toc" aria-label="Sections">
    {sections.map(s => (
      <a href={`#${s.id}`} data-toc={s.id}>{s.title}</a>
    ))}
    <span class="deck-progress" aria-hidden="true">
      <span class="deck-progress-num" data-progress-num>1</span>
      <span class="muted"> / {sections.length}</span>
    </span>
  </nav>

  <main class="deck">
    {sections.map((s, i) => (
      <section
        id={s.id}
        class="deck-section"
        data-section={s.id}
        data-index={i}
        data-active={i === 0 ? 'true' : undefined}
        aria-hidden={i === 0 ? 'false' : 'true'}
      >
        <div class="deck-inner">
          <h2><span class="deck-h-num">[{String(i + 1).padStart(2, '0')}]</span> {s.title}</h2>

          {s.body && <div class="deck-body" set:html={s.body} />}

          {s.steps && (
            <ol class="deck-steps">
              {s.steps.map((step, j) => (
                <li>
                  <span class="deck-step-num">{j + 1}</span>
                  <span class="step-body">{step}</span>
                </li>
              ))}
            </ol>
          )}

          {s.defs && (
            <dl class="deck-defs">
              {s.defs.map(([k, v]) => (
                <div>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))}
            </dl>
          )}

          {s.links && (
            <ul class="deck-links">
              {s.links.map(l => (
                <li>
                  <a href={l.href}>{l.label}</a>
                  {l.note && <span class="muted"> &mdash; {l.note}</span>}
                </li>
              ))}
            </ul>
          )}
        </div>
      </section>
    ))}
  </main>

  <div class="deck-hint muted" aria-hidden="true">
    <span>scroll · arrows · swipe</span>
  </div>
</BaseLayout>

<script>
  import { setupDeck } from '../scripts/deck';
  setupDeck();
  document.addEventListener('astro:after-swap', setupDeck);
</script>
